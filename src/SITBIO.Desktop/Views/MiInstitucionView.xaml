<!-- UI-019 Mi institución (HU-024, solo AC-01; prototipo Admin.tsx › MiInstitucion). Datos editables
     a la izquierda y plan contratado con sus medidores a la derecha (RN-009). Diseño clínico
     editorial: secciones con línea fina, sin tarjetas; los medidores son barras abiertas. -->
<UserControl x:Class="Sitbio.Desktop.Views.MiInstitucionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <!-- Campo con error: Tag = mensaje; borde rojo mientras haya error -->
    <Style x:Key="CampoValidado" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Barra del medidor: pista neutra y relleno con el color del tono -->
    <Style x:Key="BarraMedidor" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Brush.Border}" />
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NotaMedidor" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <!-- Encabezado -->
      <TextBlock Text="ADMINISTRACIÓN" Style="{StaticResource Overline}" />
      <TextBlock Text="Mi institución" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                 Text="Datos de tu institución y anticipación de las alertas. El plan y su capacidad los administra el proveedor del servicio." />

      <TextBlock Text="Cargando los datos de la institución…" Style="{StaticResource Muted}" Margin="0,0,0,18"
                 Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

      <!-- Error (al cargar o al guardar) -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
              Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                          Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}"
                  VerticalAlignment="Bottom" Margin="16,0,0,0"
                  Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
        </Grid>
      </Border>

      <!-- Confirmación al guardar -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
              Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"
              Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                          Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Confirmacion.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" />
            <TextBlock Text="{Binding Confirmacion.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarConfirmacionCommand}"
                  VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>
      </Border>

      <Grid Visibility="{Binding HayDatos, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Datos de la institución -->
        <Border Style="{StaticResource Section}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Datos de la institución" Style="{StaticResource SectionTitle}" />

            <TextBlock Text="Nombre de la institución" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorNombre}">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                       AutomationProperties.Name="Nombre de la institución" />
            </Border>
            <TextBlock Text="{Binding ErrorNombre}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorNombre, Converter={StaticResource TextoVisible}}" />

            <TextBlock Text="NIT" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorNit}" MaxWidth="260" HorizontalAlignment="Left" MinWidth="260">
              <TextBox Style="{StaticResource FieldInput}" FontFamily="Consolas" Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"
                       AutomationProperties.Name="NIT" />
            </Border>
            <TextBlock Text="{Binding ErrorNit}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorNit, Converter={StaticResource TextoVisible}}" />

            <TextBlock Text="Anticipación de las alertas de vencimiento" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorDias}" Width="200" HorizontalAlignment="Left">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="días" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Dias, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
                         AutomationProperties.Name="Anticipación de las alertas en días" />
              </DockPanel>
            </Border>
            <TextBlock Text="{Binding ErrorDias}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorDias, Converter={StaticResource TextoVisible}}" />
            <TextBlock Text="Días antes del vencimiento de preventivos y calibraciones (RF-020)." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />

            <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                    HorizontalAlignment="Right" Margin="0,24,0,0" />
          </StackPanel>
        </Border>

        <!-- Plan contratado (RN-009): solo consulta -->
        <Border Grid.Column="2" Style="{StaticResource Section}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{Binding TituloPlan}" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Valor de referencia" Style="{StaticResource Muted}" FontSize="13" />
                <TextBlock Text="{Binding ValorPlan}" Foreground="{DynamicResource Brush.Text}" FontSize="15" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Vigente hasta" Style="{StaticResource Muted}" FontSize="13" />
                <TextBlock Text="{Binding VigenteHasta}" Foreground="{DynamicResource Brush.Text}" FontSize="15" Margin="0,3,0,0" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Medidores}" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MedidorVista}">
                  <StackPanel Margin="0,16,0,0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Unidad}" Style="{StaticResource Muted}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Bottom" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Uso}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource BarraMedidor}" Value="{Binding Barra, Mode=OneWay}" Margin="0,8,0,0"
                                 AutomationProperties.Name="{Binding Etiqueta}" />
                    <TextBlock Text="{Binding Nota}" Style="{StaticResource NotaMedidor}" Visibility="{Binding Nota, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="El personal clínico no tiene límite y las cuentas del ente regulador no se cuentan. Los equipos dados de baja no consumen capacidad." />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
