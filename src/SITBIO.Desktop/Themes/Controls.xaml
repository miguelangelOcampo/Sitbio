<!-- Estilos de los componentes (DOC-05) con el concepto «clínico editorial»:
     las secciones se separan con líneas finas y espacio, no con tarjetas.
     Las cajas con borde completo quedan solo para diálogos, menús y campos. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:Sitbio.Desktop.Controls"
                    xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
                    xmlns:views="clr-namespace:Sitbio.Desktop.Views">

  <!-- Foco visible solo con teclado (FocusVisualStyle): anillo de 2 px alrededor del control -->
  <Style x:Key="FocoTeclado">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Brush.Focus}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocoTecladoRiel">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="8,3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.BrandRing}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sección abierta: línea fina arriba y aire; reemplaza a la tarjeta -->
  <Style x:Key="Section" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,14,0,0" />
  </Style>

  <!-- Diálogo o menú: único caso con caja completa -->
  <Style x:Key="Dialog" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Space.6}" />
    <!-- H-02: aparece con un desvanecido corto (sin animar si Windows reduce las animaciones) -->
    <Setter Property="views:Animacion.Entrada" Value="True" />
  </Style>

  <!-- Tipografía -->
  <!-- I-06: texto de solo lectura que se ve como un TextBlock pero se puede seleccionar y copiar -->
  <Style TargetType="controls:TextoCopiable">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- El cuadro de texto deja 2 px a cada lado: se compensan para alinear con los TextBlock -->
    <Setter Property="Padding" Value="-2,0" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:TextoCopiable">
          <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                        Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <!-- Etiqueta pequeña: escribir el texto en MAYÚSCULAS -->
  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Franja de indicadores: contenedor con líneas arriba y abajo; cada indicador separado por una línea vertical -->
  <Style x:Key="KpiStrip" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>
  <Style x:Key="KpiItem" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="20,14" />
  </Style>
  <Style x:Key="KpiValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- Estado: punto de color + texto (sin pastilla). Ej.: <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Success}" /> -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Fila de lista con divisor inferior (tiquetes, técnicos, alertas) -->
  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,12" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Opción del menú lateral: sin píldora; la activa lleva una barra a la izquierda -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" MinHeight="38">
            <Border x:Name="Barra" Width="3" HorizontalAlignment="Left" Margin="0,7" CornerRadius="0,2,2,0"
                    Background="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
            <Grid Margin="20,8,12,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- Ícono de la opción (views:Boton.Icono), como en el submenú del prototipo -->
              <Viewbox x:Name="Icono" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                <Canvas Width="24" Height="24">
                  <Path Data="{TemplateBinding views:Boton.Icono}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="views:Boton.Icono" Value="{x:Null}">
              <Setter TargetName="Icono" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campo de formulario: etiqueta arriba, caja con borde completo (permitido en campos),
       foco visible de 2 px y mensaje de error debajo -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="FieldBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text3}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,0" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FieldInput" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <!-- I-07: calendario con los colores del tema (claro y oscuro) -->
  <Style x:Key="CalendarioBotonNav" TargetType="Button">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarioDia" TargetType="CalendarDayButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Grid>
            <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" />
            <Border x:Name="Hoy" BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.5" CornerRadius="8" Visibility="Collapsed" />
            <Border x:Name="Foco" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="Hoy" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarioMes" TargetType="CalendarButton">
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Grid>
            <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" />
            <Border x:Name="Foco" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarioHoja" TargetType="CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{ComponentResourceKey ResourceId=DayTitleTemplate, TypeInTargetAssembly={x:Type CalendarItem}}">
              <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,4,0,6" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Text3}" />
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid x:Name="PART_Root">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="PART_PreviousButton" Style="{StaticResource CalendarioBotonNav}" AutomationProperties.Name="Mes anterior">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Chevron}" Width="16" Height="16"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                  <ContentControl.LayoutTransform>
                    <RotateTransform Angle="90" />
                  </ContentControl.LayoutTransform>
                </ContentControl>
              </Button>
              <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" Cursor="Hand" HorizontalAlignment="Center"
                      AutomationProperties.Name="Cambiar de vista">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" Padding="10,5">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Button.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                  </DataTemplate>
                </Button.ContentTemplate>
              </Button>
              <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource CalendarioBotonNav}" AutomationProperties.Name="Mes siguiente">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Chevron}" Width="16" Height="16"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                  <ContentControl.LayoutTransform>
                    <RotateTransform Angle="-90" />
                  </ContentControl.LayoutTransform>
                </ContentControl>
              </Button>
            </Grid>
            <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
            <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
            <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2" Fill="{DynamicResource Brush.Surface}" Opacity="0" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Vista de meses (año) y de años (década): se oculta la cuadrícula de días -->
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
              <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Calendario" TargetType="Calendar">
    <Setter Property="Language" Value="es-CO" />
    <Setter Property="FirstDayOfWeek" Value="Monday" />
    <Setter Property="IsTodayHighlighted" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarioHoja}" />
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarioDia}" />
    <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarioMes}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <StackPanel x:Name="PART_Root">
            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- I-07: campo de fecha. Se escribe a mano («dd/mm/aaaa») o se elige en el calendario del botón -->
  <Style TargetType="controls:CampoFecha" BasedOn="{StaticResource FieldInput}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:CampoFecha">
          <Grid x:Name="Raiz">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            <ToggleButton x:Name="Boton" Grid.Column="1" Focusable="False" Cursor="Hand" Margin="6,0,-6,0" ToolTip="Elegir en el calendario"
                          AutomationProperties.Name="Abrir calendario"
                          IsChecked="{Binding Abierto, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Fondo" Background="Transparent" CornerRadius="8" Width="32" Height="32">
                    <ContentControl x:Name="Icono" Style="{StaticResource Icono}" Content="{StaticResource Icono.Calendario}" Width="18" Height="18"
                                    Foreground="{DynamicResource Brush.Text2}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                      <Setter TargetName="Icono" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                      <Setter TargetName="Icono" Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="Ventana" IsOpen="{Binding Abierto, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=Raiz}" Placement="Bottom" HorizontalOffset="-14" VerticalOffset="12"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="12" Padding="10" Margin="0,0,8,8">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                </Border.Effect>
                <Calendar x:Name="PART_Calendario" Style="{StaticResource Calendario}" AutomationProperties.Name="Calendario" />
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Con el calendario abierto, el clic en el botón solo lo cierra (no lo vuelve a abrir) -->
            <Trigger SourceName="Ventana" Property="IsOpen" Value="True">
              <Setter TargetName="Boton" Property="IsHitTestVisible" Value="False" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Raiz" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldPassword" TargetType="PasswordBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="FieldError" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- Botón principal: verde de marca, texto blanco; foco con anillo exterior -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Button}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
            <Viewbox x:Name="Icono" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{TemplateBinding views:Boton.Icono}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="views:Boton.Icono" Value="{x:Null}">
              <Setter TargetName="Icono" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Acción destructiva confirmada en un diálogo (Desactivar); Tag = color al pasar el mouse -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Tag" Value="{DynamicResource Brush.DangerText}" />
  </Style>

  <!-- Casilla de formulario (p. ej. «No se conoce»): cuadro de 18 px con borde de campo y marca de verificación -->
  <Style x:Key="Casilla" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Cuadro" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Brush.BorderControl}" Background="{DynamicResource Brush.Surface}">
              <Path x:Name="Marca" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="{DynamicResource Brush.OnPrimary}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="-1.5" />
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Cuadro" Property="Background" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Cuadro" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cuadro" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Opción única de formulario (p. ej. motivo de la baja): círculo de 18 px con punto al elegirla -->
  <Style x:Key="OpcionRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse x:Name="Circulo" StrokeThickness="1.5" Stroke="{DynamicResource Brush.BorderControl}" Fill="{DynamicResource Brush.Surface}" />
              <Ellipse x:Name="Punto" Width="8" Height="8" Fill="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Circulo" Property="Stroke" Value="{DynamicResource Brush.Primary}" />
              <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circulo" Property="Stroke" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Velo detrás de un diálogo o panel lateral; al pulsarlo ejecuta su Command (por ejemplo, cancelar) -->
  <Style x:Key="Velo" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Rectangle Fill="{DynamicResource Brush.Scrim}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Acción secundaria como enlace de texto -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Viewbox x:Name="Icono" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{TemplateBinding views:Boton.Icono}" Stroke="{Binding Foreground, ElementName=Texto}" StrokeThickness="1.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
            <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="views:Boton.Icono" Value="{x:Null}">
              <Setter TargetName="Icono" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <!-- Deshabilitado (p. ej. «Siguiente ›» en la última página): gris y sin subrayado -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Texto" Property="Foreground" Value="{DynamicResource Brush.Text3}" />
              <Setter TargetName="Texto" Property="TextDecorations" Value="{x:Null}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón de ícono dentro de un campo (Mostrar/Ocultar) -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Aviso en línea: fondo suave y barra a la izquierda, sin caja completa.
       Error: <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"> -->
  <Style x:Key="InfoBar" TargetType="Border">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="14,11" />
  </Style>

  <!-- Riel de módulos (78 px, fondo de marca): ícono + nombre corto. IsChecked = módulo abierto en el panel;
       Tag = True para el módulo de la pantalla actual (barra lima a la izquierda). -->
  <Style x:Key="RailItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanelMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTecladoRiel}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Fondo" Margin="8,3" CornerRadius="10" Background="{DynamicResource Brush.OnBrandPanel}" Opacity="0" />
            <Border x:Name="Barra" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,2,2,0"
                    Background="{DynamicResource Brush.BrandRing}" Visibility="Collapsed" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.08" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.12" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value>
                <sys:Boolean>True</sys:Boolean>
              </Trigger.Value>
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Panel de navegación (200 px, claro) junto al riel: nombre del módulo, buscador y opciones -->
  <Style x:Key="NavPanel" TargetType="Border">
    <Setter Property="Width" Value="200" />
    <Setter Property="Background" Value="{DynamicResource Brush.Nav}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Pestaña: texto con barra inferior en la activa (sin caja) -->
  <Style x:Key="Pestana" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="0,0,28,0">
            <ContentPresenter Margin="0,10,0,12" />
            <Border x:Name="Barra" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista desplegable de formulario: caja como FieldBox y opciones en un menú -->
  <Style x:Key="FieldComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fondo" Background="Transparent" Padding="12,8" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldCombo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Borde" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderControl}"
                          BorderThickness="1" CornerRadius="{StaticResource Radius.Field}" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Brush.Text2}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="Foco" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="{StaticResource Radius.Field}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Margin="13,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Chevron}" Width="16" Height="16"
                            HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text2}" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Field}" Padding="4" Margin="0,4,0,0" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menú de acciones de una fila (caja permitida en menús) -->
  <Style x:Key="MenuFilaItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Fondo" Background="Transparent" Padding="14,9" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
              <!-- Ícono opcional (views:Boton.Icono), como en los menús del prototipo -->
              <Viewbox x:Name="Icono" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{TemplateBinding views:Boton.Icono}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="views:Boton.Icono" Value="{x:Null}">
              <Setter TargetName="Icono" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuFila" TargetType="ContextMenu">
    <Setter Property="ItemContainerStyle" Value="{StaticResource MenuFilaItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Field}" Padding="4" MinWidth="200" views:Animacion.Entrada="True">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabla abierta: sin marco, solo divisores horizontales -->
  <Style x:Key="OpenGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="13,10,14,10" />
  </Style>
  <!-- Fila: la seleccionada lleva una barra a la izquierda, sin relleno de color -->
  <Style x:Key="OpenGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
      </Trigger>
      <!-- I-09: las filas que abren un detalle se ven clicables -->
      <Trigger Property="controls:FilaClicable.Activa" Value="True">
        <Setter Property="Cursor" Value="Hand" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="controls:FilaClicable.Activa" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OpenGridCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <ContentPresenter Margin="10,0,14,0" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OpenGrid" TargetType="DataGrid">
    <!-- I-06: Ctrl + C copia la celda y Ctrl + Mayús + C la fila -->
    <Setter Property="controls:TablaCopiable.Activa" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource OpenGridHeader}" />
    <Setter Property="RowStyle" Value="{StaticResource OpenGridRow}" />
    <Setter Property="CellStyle" Value="{StaticResource OpenGridCell}" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <!-- La rueda del mouse baja la página cuando la tabla no tiene desplazamiento propio -->
    <Setter Property="views:RuedaHaciaPadre.Activa" Value="True" />
  </Style>

  <BooleanToVisibilityConverter x:Key="VisibleSiVerdadero" />

  <!-- Botón secundario pequeño («Descartar», «Ver reportes») -->
  <Style x:Key="BotonSecundario" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderControl}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Caja" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Button}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Caja" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    I-11 (HU-020): alerta de vencimiento con el diseño del prototipo (Panel, «Atención requerida»): ficha con el ícono del
    tipo en el tono de la alerta, tipo, prioridad con punto de color, tiempo relativo, título, detalle y las acciones
    «Ver detalle» y «Descartar». La usan el centro de alertas y la pantalla Mantenimientos; el ItemsControl que la
    contiene debe tener AbrirAlertaCommand y MarcarRevisadaCommand en su DataContext.
  -->
  <DataTemplate x:Key="TarjetaAlerta" DataType="{x:Type vm:FilaAlerta}">
    <Border x:Name="Tarjeta" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
            Background="{DynamicResource Brush.Surface}" Padding="14,12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Ficha" Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,12,0"
                Background="{DynamicResource Brush.Surface2}" TextElement.Foreground="{DynamicResource Brush.Text2}">
          <ContentControl x:Name="IconoFicha" Style="{StaticResource Icono}" Width="18" Height="18" Foreground="{DynamicResource Brush.Text2}">
            <ContentControl.Content>
              <Binding Path="Icono">
                <Binding.Converter>
                  <views:RecursoConverter />
                </Binding.Converter>
              </Binding>
            </ContentControl.Content>
          </ContentControl>
        </Border>
        <StackPanel Grid.Column="1">
          <!-- Tipo, prioridad y tiempo relativo; en paneles angostos el tiempo pasa a la línea siguiente -->
          <WrapPanel>
            <TextBlock Text="{Binding Tipo}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" Margin="0,2,8,2" />
            <Border x:Name="Prioridad" CornerRadius="10" Padding="8,2" Margin="0,0,8,0" Background="{DynamicResource Brush.Surface2}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Punto" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Text3}" />
                <TextBlock x:Name="TextoPrioridad" Text="{Binding Prioridad}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text2}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Reloj}" Width="12" Height="12" Margin="0,0,4,0"
                              Foreground="{DynamicResource Brush.Text3}" />
              <TextBlock Text="{Binding Cuando}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
              <TextBlock Text=" · Descartada" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                         Visibility="{Binding Revisada, Converter={StaticResource VisibleSiVerdadero}}" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock Text="{Binding Detalle}" FontSize="13" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="Orden" Text="{Binding Orden}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Height="30" FontSize="13" Padding="10,0"
                    Command="{Binding DataContext.AbrirAlertaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Titulo, StringFormat='Ver detalle: {0}'}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Ojo}" Width="14" Height="14" Margin="0,0,6,0"
                                Foreground="{DynamicResource Brush.OnPrimary}" />
                <TextBlock Text="Ver detalle" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="Descartar" Style="{StaticResource BotonSecundario}" Content="Descartar" Height="30" FontSize="13" Padding="10,0" Margin="8,0,0,0"
                    Command="{Binding DataContext.MarcarRevisadaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Titulo, StringFormat='Descartar: {0}'}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
        <Setter TargetName="Ficha" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter TargetName="IconoFicha" Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
        <Setter TargetName="Ficha" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter TargetName="IconoFicha" Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding TonoPrioridad}" Value="{x:Static vm:TonoEstado.Advertencia}">
        <Setter TargetName="Prioridad" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
        <Setter TargetName="Punto" Property="Fill" Value="{DynamicResource Brush.Warning}" />
        <Setter TargetName="TextoPrioridad" Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding TonoPrioridad}" Value="{x:Static vm:TonoEstado.Critico}">
        <Setter TargetName="Prioridad" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter TargetName="Punto" Property="Fill" Value="{DynamicResource Brush.Danger}" />
        <Setter TargetName="TextoPrioridad" Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Orden}" Value="{x:Null}">
        <Setter TargetName="Orden" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Revisada}" Value="True">
        <Setter TargetName="Tarjeta" Property="Opacity" Value="0.62" />
        <Setter TargetName="Descartar" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Reportes y Panel (I-12): mini gráfico de un indicador (barras, línea o arco) con etiqueta al pasar el mouse -->
  <Style x:Key="MiniGrafico" TargetType="controls:Grafico">
    <Setter Property="Compacto" Value="True" />
    <Setter Property="Width" Value="68" />
    <Setter Property="Height" Value="36" />
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="10,0,0,6" />
    <Setter Property="views:Animacion.Crecer" Value="True" />
  </Style>
  <!--
    I-14: ilustración de los estados vacíos, como en el prototipo: anillos suaves, la ficha con el ícono de la pantalla
    y dos puntos decorativos. Uso: <ContentControl Style="{StaticResource IlustracionVacia}" Content="{StaticResource Icono.Bandeja}" />
  -->
  <Style x:Key="IlustracionVacia" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid Width="104" Height="88">
            <Ellipse Width="88" Height="88" Fill="{DynamicResource Brush.Surface2}" />
            <Ellipse Width="64" Height="64" Fill="{DynamicResource Brush.PrimarySoft}" />
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <ContentControl Style="{StaticResource Icono}" Content="{TemplateBinding Content}" Width="22" Height="22"
                              Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Primary}" Opacity="0.35"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" />
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Warning}" Opacity="0.6"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,14" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
