<!-- UI-005 Equipos biomédicos y UI-006 Hoja de vida (HU-002; prototipo v0.21, Equipos.tsx). La hoja de
     vida se abre encima de la lista y, al volver por las migas, la lista conserva filtros y página
     (NAV-006). Diseño clínico editorial: tabla abierta, estado como punto + texto, sin tarjetas. -->
<UserControl x:Class="Sitbio.Desktop.Views.EquiposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:BytesImagenConverter x:Key="Imagen" />
    <views:RecursoConverter x:Key="Recurso" />

    <!-- Campo con error: Tag = mensaje; borde rojo mientras haya error -->
    <Style x:Key="CampoValidado" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Aviso en línea: rojo si es error; verde si confirma una acción -->
    <DataTemplate x:Key="PlantillaAviso" DataType="{x:Type vm:Aviso}">
      <Border x:Name="Barra" Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
              AutomationProperties.LiveSetting="Assertive" ToolTip="{Binding Codigo}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ContentControl x:Name="Icono" Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                          Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <DockPanel>
              <TextBlock x:Name="Titulo" Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Visibility="{Binding Mensaje, Converter={StaticResource TextoVisible}}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding EsError}" Value="False">
          <Setter TargetName="Barra" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
          <Setter TargetName="Barra" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
          <Setter TargetName="Icono" Property="Content" Value="{StaticResource Icono.Check}" />
          <Setter TargetName="Icono" Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
          <Setter TargetName="Titulo" Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Punto de estado según el tono -->
    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Pares etiqueta–valor de la hoja de vida -->
    <DataTemplate x:Key="PlantillaDato" DataType="{x:Type vm:Dato}">
      <StackPanel Margin="0,0,24,18">
        <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Muted}" FontSize="13" />
        <TextBlock x:Name="Valor" Text="{Binding Valor}" Foreground="{DynamicResource Brush.Text}" FontSize="15"
                   TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Codigo}" Value="True">
          <Setter TargetName="Valor" Property="FontFamily" Value="Consolas" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Encabezado de columna de las tablas abiertas de la hoja de vida -->
    <Style x:Key="EncabezadoTabla" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
      <Setter Property="Margin" Value="0,0,12,8" />
    </Style>

    <!-- UI-006 pestaña Mantenimientos (prototipo HojaVida.tsx, sección 3): plan vigente, órdenes y calibraciones -->
    <DataTemplate DataType="{x:Type vm:MantenimientosEquipoViewModel}">
      <StackPanel>
        <TextBlock Text="Consultando el plan, las órdenes y las calibraciones…" Style="{StaticResource Muted}" Margin="0,0,0,14"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
        <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Style="{StaticResource LinkButton}" Content="Reintentar" Command="{Binding CargarCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"
                AutomationProperties.Name="Volver a consultar los mantenimientos"
                Visibility="{Binding HayAviso, Converter={StaticResource Visible}}" />

        <!-- Plan preventivo vigente (HU-019) -->
        <Border Style="{StaticResource Section}">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="Plan preventivo vigente" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <ContentControl Content="{Binding AvisoPlan}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
            <TextBlock Text="Este equipo no tiene un plan preventivo activo." Style="{StaticResource Muted}"
                       Visibility="{Binding SinPlan, Converter={StaticResource Visible}}" />
            <StackPanel Visibility="{Binding HayPlan, Converter={StaticResource Visible}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="Periodicidad" Style="{StaticResource Muted}" FontSize="13" />
                  <TextBlock Text="{Binding Periodicidad}" Foreground="{DynamicResource Brush.Text}" FontSize="15" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                  <TextBlock Text="Última ejecución" Style="{StaticResource Muted}" FontSize="13" />
                  <TextBlock Text="{Binding UltimaEjecucion}" Foreground="{DynamicResource Brush.Text}" FontSize="15" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Próxima fecha" Style="{StaticResource Muted}" FontSize="13" />
                  <TextBlock Text="{Binding ProximaFecha}" FontSize="15" Margin="0,3,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PlanVencido}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding DetalleProxima}" Style="{StaticResource Muted}" FontSize="13" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding DescripcionPlan}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,14,0,0"
                         Visibility="{Binding DescripcionPlan, Converter={StaticResource TextoVisible}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Órdenes de trabajo del equipo (API-OT); AC-05 no las consulta -->
        <Border Style="{StaticResource Section}" Margin="0,14,0,0" Visibility="{Binding PuedeVerOrdenes, Converter={StaticResource Visible}}">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock DockPanel.Dock="Right" Text="{Binding ResumenOrdenes}" Style="{StaticResource Overline}" VerticalAlignment="Center" />
              <TextBlock Text="Órdenes de trabajo" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <TextBlock Text="Solo ves las órdenes asignadas a ti." Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10"
                       Visibility="{Binding SoloSuyas, Converter={StaticResource Visible}}" />
            <ContentControl Content="{Binding AvisoOrdenes}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
            <TextBlock Text="Este equipo aún no tiene órdenes de trabajo." Style="{StaticResource Muted}"
                       Visibility="{Binding SinOrdenes, Converter={StaticResource Visible}}" />
            <Grid Visibility="{Binding ResumenOrdenes, Converter={StaticResource TextoVisible}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="FECHA" Style="{StaticResource EncabezadoTabla}" />
              <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource EncabezadoTabla}" />
              <TextBlock Grid.Column="2" Text="ORIGEN" Style="{StaticResource EncabezadoTabla}" />
              <TextBlock Grid.Column="3" Text="FALLA O TRABAJO" Style="{StaticResource EncabezadoTabla}" />
              <TextBlock Grid.Column="4" Text="TÉCNICO" Style="{StaticResource EncabezadoTabla}" />
              <TextBlock Grid.Column="5" Text="ESTADO" Style="{StaticResource EncabezadoTabla}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding OrdenesEquipo}" Focusable="False" AutomationProperties.Name="Órdenes de trabajo del equipo">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrdenEquipo}">
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="140" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Fecha}" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Grid.Column="1" Text="{Binding Tipo}" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Grid.Column="2" Text="{Binding Origen}" FontFamily="Consolas" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Grid.Column="3" Text="{Binding Detalle}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="4" Text="{Binding Tecnico}" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Ellipse Style="{StaticResource PuntoEstado}" />
                        <TextBlock Text="{Binding Estado}" Foreground="{DynamicResource Brush.Text}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Calibraciones (HU-022): vigencia de la más reciente o «No aplica» (RN-010) -->
        <Border Style="{StaticResource Section}" Margin="0,14,0,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="Calibraciones" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Text="Vigencia" Style="{StaticResource Muted}" FontSize="13" />
              <TextBlock Text="{Binding Vigencia}" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" AutomationProperties.Name="Vigencia de la calibración">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding TonoVigencia}" Value="{x:Static vm:TonoEstado.Critico}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TonoVigencia}" Value="{x:Static vm:TonoEstado.Advertencia}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding TonoVigencia}" Value="{x:Static vm:TonoEstado.Exito}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding DetalleVigencia}" Style="{StaticResource Muted}" FontSize="13"
                         Visibility="{Binding DetalleVigencia, Converter={StaticResource TextoVisible}}" />
            </StackPanel>
            <ContentControl Content="{Binding AvisoCalibraciones}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
            <TextBlock Text="Aún no hay calibraciones registradas para este equipo." Style="{StaticResource Muted}"
                       Visibility="{Binding SinCalibraciones, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{Binding Calibraciones}" Focusable="False" AutomationProperties.Name="Calibraciones del equipo">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="190" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Fecha}" Foreground="{DynamicResource Brush.Text}" />
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Certificado}" FontFamily="Consolas" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Calibracion.Proveedor}" Style="{StaticResource Muted}" FontSize="12"
                                   Visibility="{Binding Calibracion.Proveedor, Converter={StaticResource NuloVisible}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Resultado}" Foreground="{DynamicResource Brush.Text}" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Ellipse Style="{StaticResource PuntoEstado}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Vigencia}" Foreground="{DynamicResource Brush.Text}" />
                          <TextBlock Text="{Binding Vence, StringFormat='Vence {0}'}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding Aprobacion}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Dato de la vista previa de la hoja de vida en PDF (papel blanco en ambos temas) -->
    <DataTemplate x:Key="DatoPdf" DataType="{x:Type vm:Dato}">
      <StackPanel Margin="0,0,14,8">
        <TextBlock Text="{Binding Etiqueta}" FontSize="9.5" Foreground="#5B6675" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Valor}" FontSize="11.5" Foreground="#1F2A37" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <!-- UI-006 Hoja de vida -->
    <DataTemplate DataType="{x:Type vm:DetalleEquipoViewModel}">
      <StackPanel>
        <!-- Migas de pan -->
        <StackPanel Orientation="Horizontal">
          <Button Content="Equipos biomédicos" Style="{StaticResource LinkButton}" Command="{Binding VolverCommand}"
                  AutomationProperties.Name="Volver a Equipos biomédicos" />
          <TextBlock Text=" / " Style="{StaticResource Muted}" />
          <TextBlock Text="{Binding Placa}" FontFamily="Consolas" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Encabezado: el recuadro del ícono es el lugar de la miniatura de la fotografía (HU-015, RF-031) -->
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <!-- Acciones (prototipo Equipos.tsx): «Reportar falla» (AC-02, AC-04), «Hoja de vida PDF» (política de la API),
               «Editar» principal (UI-007, solo AC-02) y el menú «…» con la fotografía y la baja (HU-014, RF-031) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button views:Boton.Icono="{StaticResource Icono.Sirena}" Content="Reportar falla" Style="{StaticResource LinkButton}" Command="{Binding ReportarFallaCommand}" Margin="0,0,24,0"
                    AutomationProperties.Name="Reportar una falla de este equipo"
                    Visibility="{Binding PuedeReportarFalla, Converter={StaticResource Visible}}" />
            <Button views:Boton.Icono="{StaticResource Icono.Documento}" Content="Hoja de vida PDF" Style="{StaticResource LinkButton}" Command="{Binding AbrirHojaVidaPdfCommand}" Margin="0,0,24,0"
                    AutomationProperties.Name="Ver la hoja de vida en PDF"
                    Visibility="{Binding PuedeHojaVidaPdf, Converter={StaticResource Visible}}" />
            <Button views:Boton.Icono="{StaticResource Icono.Lapiz}" Content="Editar" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Editar equipo"
                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Equipo}"
                    Visibility="{Binding PuedeEditar, Converter={StaticResource Visible}}" />
            <Button Style="{StaticResource IconButton}" Click="AbrirMenuAcciones" Tag="{Binding}" Margin="8,0,0,0"
                    AutomationProperties.Name="Más acciones del equipo" ToolTip="Más acciones"
                    Visibility="{Binding HayMasAcciones, Converter={StaticResource Visible}}">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Mas}" Width="20" Height="20" />
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource MenuFila}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Ver fotografía" Command="{Binding VerFotoCommand}"
                            Visibility="{Binding PuedeVerFoto, Converter={StaticResource Visible}}" />
                  <MenuItem Header="{Binding TextoBotonFoto}" Command="{Binding AbrirDialogoFotoCommand}"
                            Visibility="{Binding PuedeCambiarFoto, Converter={StaticResource Visible}}" />
                  <MenuItem Header="Dar de baja" Command="{Binding AbrirBajaCommand}"
                            Visibility="{Binding PuedeDarDeBaja, Converter={StaticResource Visible}}" />
                  <MenuItem Header="Revertir la baja" Command="{Binding AbrirReversionCommand}"
                            Visibility="{Binding PuedeRevertir, Converter={StaticResource Visible}}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>
          <Grid Width="56" Height="56" VerticalAlignment="Top">
            <Border CornerRadius="12" Background="{DynamicResource Brush.PrimarySoft}" AutomationProperties.Name="Ícono del tipo de equipo">
              <ContentControl Style="{StaticResource Icono}" Content="{Binding IconoTipo, Converter={StaticResource Recurso}}" Width="28" Height="28"
                              Foreground="{DynamicResource Brush.Primary}" />
            </Border>
            <!-- RF-031: la miniatura reemplaza al ícono si el usuario prefiere fotos; clic para ampliarla -->
            <Button Command="{Binding VerFotoCommand}" Cursor="Hand" ToolTip="Ver la fotografía ampliada"
                    AutomationProperties.Name="Ver la fotografía ampliada" Visibility="{Binding MuestraFoto, Converter={StaticResource Visible}}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border CornerRadius="12" Background="{DynamicResource Brush.Surface3}">
                    <Border.OpacityMask>
                      <VisualBrush>
                        <VisualBrush.Visual>
                          <Border Width="56" Height="56" CornerRadius="12" Background="Black" />
                        </VisualBrush.Visual>
                      </VisualBrush>
                    </Border.OpacityMask>
                    <Image Source="{Binding Miniatura, Converter={StaticResource Imagen}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button Width="26" Height="26" Margin="0,0,-6,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand"
                    Command="{Binding AbrirDialogoFotoCommand}" ToolTip="{Binding TextoBotonFoto}"
                    AutomationProperties.Name="{Binding TextoBotonFoto}" Visibility="{Binding PuedeCambiarFoto, Converter={StaticResource Visible}}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border CornerRadius="13" Background="{DynamicResource Brush.Primary}" BorderBrush="{DynamicResource Brush.Surface}" BorderThickness="2">
                    <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Camara}" Width="13" Height="13"
                                    Foreground="{DynamicResource Brush.OnPrimary}" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Titulo}" Style="{StaticResource PageTitle}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,4,0,0"
                          Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}">
                <Ellipse Style="{StaticResource PuntoEstado}" />
                <TextBlock Text="{Binding Estado}" Foreground="{DynamicResource Brush.Text}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
              <TextBlock Text="  ·  " Style="{StaticResource Muted}" Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Muted}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <TextBlock Text="Abriendo la hoja de vida…" Style="{StaticResource Muted}" Margin="0,18,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

        <!-- Confirmación tras guardar cambios -->
        <Grid Margin="0,18,0,0" Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}}">
          <ContentControl Content="{Binding Confirmacion}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
          <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarConfirmacionCommand}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
        </Grid>

        <!-- Error al consultar -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,18,0,0" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0" />
              <Button Content="Volver" Style="{StaticResource LinkButton}" Command="{Binding VolverCommand}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" />
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Equipo dado de baja (RF-014) -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Info}"
                Margin="0,18,0,0" Visibility="{Binding AvisoBaja, Converter={StaticResource NuloVisible}}" ToolTip="{Binding AvisoBaja.Codigo}">
          <DockPanel>
            <Button views:Boton.Icono="{StaticResource Icono.Revertir}" DockPanel.Dock="Right" Content="Revertir" Style="{StaticResource LinkButton}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                    AutomationProperties.Name="Revertir la baja" Command="{Binding AbrirReversionCommand}"
                    Visibility="{Binding PuedeRevertir, Converter={StaticResource Visible}}" />
            <StackPanel>
              <DockPanel>
                <TextBlock Text="{Binding AvisoBaja.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}" />
              </DockPanel>
              <TextBlock Text="{Binding AvisoBaja.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- RN-010: autorización vencida, por vencer o faltante (aviso, no bloqueo) -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                Margin="0,18,0,0" Visibility="{Binding AvisoRegulatorio, Converter={StaticResource NuloVisible}}" ToolTip="{Binding AvisoRegulatorio.Codigo}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock Text="{Binding AvisoRegulatorio.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
              </DockPanel>
              <TextBlock Text="{Binding AvisoRegulatorio.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}">
          <!-- Pestañas -->
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Resumen" IsChecked="{Binding EnResumen}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Información técnica" IsChecked="{Binding EnTecnica}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Mantenimientos" IsChecked="{Binding EnMantenimientos}"
                         Visibility="{Binding MuestraMantenimientos, Converter={StaticResource Visible}}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Historial" IsChecked="{Binding EnHistorial}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Documentos" IsChecked="{Binding EnDocumentos}"
                         Visibility="{Binding TieneDocumentos, Converter={StaticResource Visible}}" />
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Brush.Border}" />

          <!-- Resumen -->
          <StackPanel Visibility="{Binding EnResumen, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <Border Style="{StaticResource KpiStrip}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiItem}" BorderThickness="0" Padding="0,14,20,14">
                  <StackPanel>
                    <TextBlock Text="PRÓXIMO MANTENIMIENTO" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding ProximoMantenimiento}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                          <Setter Property="FontSize" Value="24" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding MantenimientoVencido}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetalleMantenimiento}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiItem}">
                  <StackPanel>
                    <TextBlock Text="CALIBRACIÓN" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Calibracion}" Style="{StaticResource KpiValue}" FontSize="24" />
                    <TextBlock Text="{Binding DetalleCalibracion}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiItem}">
                  <StackPanel>
                    <TextBlock Text="AUTORIZACIÓN INVIMA" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Autorizacion}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                          <Setter Property="FontSize" Value="24" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AutorizacionEnAlerta}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetalleAutorizacion}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource Section}" Margin="0,28,0,0">
              <StackPanel>
                <TextBlock Text="Datos del activo" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding DatosActivo}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Información técnica -->
          <StackPanel Visibility="{Binding EnTecnica, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Información técnica" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding InformacionTecnica}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <TextBlock Text="Información regulatoria" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding InformacionRegulatoria}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Mantenimientos: plan vigente, órdenes y calibraciones -->
          <ContentControl Content="{Binding Mantenimientos}" Focusable="False" IsTabStop="False" Margin="0,22,0,0"
                          Visibility="{Binding EnMantenimientos, Converter={StaticResource Visible}}" />

          <!-- Documentos (HU-015; prototipo HojaVida.tsx, DocumentosEquipo) -->
          <StackPanel Visibility="{Binding EnDocumentos, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <StackPanel DataContext="{Binding Documentos}">
              <ContentControl Content="{Binding Confirmacion}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,0,0,14"
                              Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}" />
              <ContentControl Content="{Binding Aviso}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,0,0,10"
                              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}" />
              <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Style="{StaticResource LinkButton}" Content="Reintentar" Command="{Binding CargarCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              <Border Style="{StaticResource Section}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AbrirAgregarCommand}" VerticalAlignment="Center"
                            AutomationProperties.Name="Agregar documento" Visibility="{Binding PuedeGestionar, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                      <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Agregar}" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Agregar documento" />
                      </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Documentos del equipo" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="{Binding Cantidad}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="12,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Text="Cargando los documentos…" Style="{StaticResource Muted}" Margin="0,8,0,0"
                             Visibility="{Binding Cargando, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
                  <!-- Estado vacío -->
                  <StackPanel HorizontalAlignment="Center" Margin="0,28" Visibility="{Binding SinDocumentos, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
                    <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Documento}" Width="28" Height="28"
                                    Foreground="{DynamicResource Brush.Text3}" HorizontalAlignment="Center" />
                    <TextBlock Text="Este equipo no tiene documentos" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding TextoVacio}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding PuedeGestionar, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Filas}" Focusable="False" AutomationProperties.Name="Documentos del equipo">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:FilaDocumento}">
                        <Border Style="{StaticResource ListRow}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <!-- Acciones secundarias como enlaces de texto (diseño clínico editorial) -->
                              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Descargar}" Width="16" Height="16" Margin="0,0,6,0"
                                              Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" />
                              <Button views:Boton.Icono="{StaticResource Icono.Descargar}" Content="Descargar" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Nombre, StringFormat=Descargar {0}}"
                                      Command="{Binding DataContext.DescargarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                              <Button Content="Desactivar" Style="{StaticResource LinkButton}" Foreground="{DynamicResource Brush.DangerText}" Margin="24,0,0,0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Nombre, StringFormat=Desactivar {0}}"
                                      Command="{Binding DataContext.PedirDesactivarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                      Visibility="{Binding DataContext.PuedeGestionar, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <!-- Ícono por formato: imagen (azul) o documento (rojo), como el prototipo -->
                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerText}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsImagen}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
                                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoText}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <ContentControl Width="16" Height="16">
                                <ContentControl.Style>
                                  <Style TargetType="ContentControl" BasedOn="{StaticResource Icono}">
                                    <Setter Property="Content" Value="{StaticResource Icono.Documento}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding EsImagen}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Icono.Imagen}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ContentControl.Style>
                              </ContentControl>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Detalle}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Historial: línea de tiempo (HU-023, CMP-UI-014) -->
          <StackPanel Visibility="{Binding EnHistorial, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <ContentControl Content="{Binding AvisoHistorial}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
            <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Style="{StaticResource LinkButton}" Content="Reintentar" Command="{Binding CargarHistorialCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Visibility="{Binding AvisoHistorial, Converter={StaticResource NuloVisible}}" />
            <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding HistorialIncompleto, Converter={StaticResource NuloVisible}}">
              <StackPanel>
                <TextBlock Text="{Binding HistorialIncompleto.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
                <TextBlock Text="{Binding HistorialIncompleto.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <TextBlock Text="Línea de tiempo" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <TextBlock Text="Cargando el historial…" Style="{StaticResource Muted}"
                           Visibility="{Binding CargandoHistorial, Converter={StaticResource Visible}}" />
                <TextBlock Text="Este equipo aún no tiene eventos registrados." Style="{StaticResource Muted}"
                           Visibility="{Binding SinEventos, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Eventos}" Focusable="False" AutomationProperties.Name="Línea de tiempo del equipo">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilaEvento}">
                      <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="28" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Fecha}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                        <Border Grid.Column="1" Width="2" Background="{DynamicResource Brush.Border}" HorizontalAlignment="Center" />
                        <Ellipse Grid.Column="1" Style="{StaticResource PuntoEstado}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="2" Margin="0,0,0,14">
                          <TextBlock Text="{Binding Tipo}" Style="{StaticResource Overline}" />
                          <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0" />
                          <TextBlock Text="{Binding Detalle}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,2,0,0"
                                     Visibility="{Binding Detalle, Converter={StaticResource NuloVisible}}" />
                          <TextBlock Text="{Binding Responsable}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                                     Visibility="{Binding Responsable, Converter={StaticResource NuloVisible}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <ContentControl Content="{Binding Detalle}" Focusable="False" IsTabStop="False"
                      Visibility="{Binding Detalle, Converter={StaticResource NuloVisible}}" />

      <!-- UI-005 Lista -->
      <StackPanel Visibility="{Binding EnLista, Converter={StaticResource Visible}}">
        <TextBlock Text="GESTIÓN BIOMÉDICA" Style="{StaticResource Overline}" />
        <DockPanel Margin="0,6,0,24">
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NuevoEquipoCommand}" VerticalAlignment="Top"
                  AutomationProperties.Name="Registrar equipo" Visibility="{Binding PuedeGestionar, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Agregar}" Foreground="{DynamicResource Brush.OnPrimary}" Margin="0,0,8,0" />
              <TextBlock Text="Registrar equipo" />
            </StackPanel>
          </Button>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Text="Equipos biomédicos" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Inventario de la institución con estado operativo, ubicación, clase de riesgo y próximo mantenimiento de cada activo." />
          </StackPanel>
        </DockPanel>

        <!-- Confirmación tras registrar -->
        <Grid Margin="0,0,0,18" Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}}">
          <ContentControl Content="{Binding Confirmacion}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" />
          <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarConfirmacionCommand}"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
        </Grid>

        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" ToolTip="{Binding Aviso.Codigo}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Filtros -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesBuscarPor}"
                    SelectedItem="{Binding BuscarPor}" DisplayMemberPath="Texto" AutomationProperties.Name="Buscar por" />
          <Border Grid.Column="2" Style="{StaticResource FieldBox}" MinHeight="42">
            <DockPanel>
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Buscar}" Width="16" Height="16" Margin="0,0,10,0" />
              <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                       AutomationProperties.Name="{Binding TextoBusqueda}" />
            </DockPanel>
          </Border>
          <!-- Texto de ayuda mientras la búsqueda está vacía -->
          <TextBlock Grid.Column="2" Text="{Binding TextoBusqueda}" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Busqueda.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ComboBox Grid.Column="4" Style="{StaticResource FieldCombo}" ItemsSource="{Binding OpcionesTipo}"
                    SelectedItem="{Binding FiltroTipo}" DisplayMemberPath="Texto" AutomationProperties.Name="Tipo de equipo" />
          <ComboBox Grid.Column="6" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesEstado}"
                    SelectedItem="{Binding FiltroEstado}" DisplayMemberPath="Texto" AutomationProperties.Name="Estado operativo" />
          <ComboBox Grid.Column="8" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesRiesgo}"
                    SelectedItem="{Binding FiltroRiesgo}" DisplayMemberPath="Texto" AutomationProperties.Name="Riesgo y calibración" />
        </Grid>

        <DockPanel Margin="0,18,0,0">
          <Button DockPanel.Dock="Right" Content="Limpiar filtros" Style="{StaticResource LinkButton}" Command="{Binding LimpiarCommand}"
                  Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding ResumenTotal}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Tabla abierta: doble clic o Enter abre la hoja de vida (NAV-006) -->
        <DataGrid x:Name="TablaEquipos" Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="60" Margin="0,8,0,0"
                  AutomationProperties.Name="Equipos biomédicos" ScrollViewer.CanContentScroll="False"
                  MouseDoubleClick="TablaEquipos_MouseDoubleClick" PreviewKeyDown="TablaEquipos_PreviewKeyDown">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="CÓDIGO DE ACTIVO" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontWeight="SemiBold" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <DockPanel>
                    <!-- RF-031: miniatura del equipo o, sin foto, el ícono del tipo -->
                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Border CornerRadius="9" Background="{DynamicResource Brush.PrimarySoft}">
                        <ContentControl Style="{StaticResource Icono}" Content="{Binding IconoTipo, Converter={StaticResource Recurso}}" Width="18" Height="18"
                                        Foreground="{DynamicResource Brush.Primary}" />
                      </Border>
                      <Border CornerRadius="9" Visibility="{Binding Foto.HayImagen, Converter={StaticResource Visible}}">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Foto.Imagen, Converter={StaticResource Imagen}}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tipo}" />
                      <TextBlock Text="{Binding Serie}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="RIESGO" Width="0.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Clase}" FontWeight="SemiBold" ToolTip="{Binding DescripcionClase}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="FABRICANTE" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Fabricante}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="UBICACIÓN" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Ubicacion}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ubicacion}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoEstado}" />
                      <TextBlock Text="{Binding Estado}" />
                    </StackPanel>
                    <TextBlock x:Name="AvisoRegistro" Text="{Binding AvisoRegistro}" FontSize="12" Margin="16,1,0,0"
                               Foreground="{DynamicResource Brush.WarningText}"
                               Visibility="{Binding AvisoRegistro, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="PRÓX. MANTENIMIENTO" Width="1.2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProximoMantenimiento}" />
                    <TextBlock Text="{Binding DetalleMantenimiento}" FontSize="12" Margin="6,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.WarningText}"
                               Visibility="{Binding DetalleMantenimiento, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{Binding SinEquipos, Converter={StaticResource Visible}}">
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Buscar}" Width="28" Height="28"
                          Foreground="{DynamicResource Brush.Text3}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Text="No encontramos equipos con esos criterios" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Text="Prueba con otro código o quita algún filtro." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Pie: resumen y paginación -->
        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>

    <!-- ================= UI-007 Registrar o editar equipo (panel lateral, solo AC-02) ================= -->
    <Grid Visibility="{Binding Formulario, Converter={StaticResource NuloVisible}}">
      <Button Style="{StaticResource Velo}" Command="{Binding CerrarFormularioCommand}" />
      <Border Width="640" HorizontalAlignment="Right" Background="{DynamicResource Brush.Elevated}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" DataContext="{Binding Formulario}"
              AutomationProperties.Name="{Binding Titulo}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="28,20,16,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" AutomationProperties.Name="Cerrar"
                    Command="{Binding DataContext.CerrarFormularioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
            </Button>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Equipo}" Foreground="{DynamicResource Brush.Primary}"
                            Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource SectionTitle}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0"
                      Command="{Binding DataContext.CerrarFormularioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Button Content="{Binding TextoGuardar}" Style="{StaticResource PrimaryButton}"
                      Command="{Binding DataContext.GuardarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,8,28,28">
              <ContentControl Content="{Binding Aviso}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,0,0,16"
                              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" />
              <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                      Margin="0,0,0,16" Visibility="{Binding FaltanCatalogos, Converter={StaticResource Visible}}">
                <DockPanel>
                  <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.AlertaTriangulo}"
                                  Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                  <StackPanel>
                    <TextBlock Text="Faltan catálogos" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Para registrar equipos, la institución necesita al menos un tipo de equipo y un área activos (Admin › Catálogos)." />
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- Identificación -->
              <TextBlock Text="IDENTIFICACIÓN" Style="{StaticResource Overline}" Margin="0,0,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Código de activo (placa)" Style="{StaticResource FieldLabel}" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorPlaca}">
                    <TextBox Style="{StaticResource FieldInput}" FontFamily="Consolas" Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Código de activo" />
                  </Border>
                  <TextBlock Text="{Binding ErrorPlaca}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorPlaca, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Número de serie" Style="{StaticResource FieldLabel}" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorSerie}">
                    <TextBox Style="{StaticResource FieldInput}" FontFamily="Consolas" Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Número de serie" />
                  </Border>
                  <TextBlock Text="{Binding ErrorSerie}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorSerie, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Tipo de equipo" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
              <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" DisplayMemberPath="Nombre"
                        AutomationProperties.Name="Tipo de equipo" />
              <TextBlock Text="{Binding ErrorTipo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorTipo, Converter={StaticResource TextoVisible}}" />
              <TextBlock Text="Al elegirlo se proponen su clase de riesgo y su calibración." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Marca (fabricante)" Style="{StaticResource FieldLabel}" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorMarca}">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Marca" />
                  </Border>
                  <TextBlock Text="{Binding ErrorMarca}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorMarca, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Modelo" Style="{StaticResource FieldLabel}" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorModelo}">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Modelo" />
                  </Border>
                  <TextBlock Text="{Binding ErrorModelo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorModelo, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
              </Grid>

              <!-- Información regulatoria (RF-030) -->
              <Border Style="{StaticResource Section}" Margin="0,24,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="INFORMACIÓN REGULATORIA" Style="{StaticResource Overline}" />
                  </DockPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Autorización INVIMA" Style="{StaticResource FieldLabel}" />
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:FormularioEquipoViewModel.OpcionesAutorizacion}"
                                SelectedItem="{Binding TipoAutorizacion}" DisplayMemberPath="Texto" AutomationProperties.Name="Autorización INVIMA" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Número" Style="{StaticResource FieldLabel}" />
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorRegistro}">
                        <TextBox Style="{StaticResource FieldInput}" FontFamily="Consolas" Text="{Binding RegistroInvima, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Número de la autorización INVIMA" />
                      </Border>
                      <TextBlock Text="{Binding ErrorRegistro}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorRegistro, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Vigente hasta" Style="{StaticResource FieldLabel}" />
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorVence}">
                        <TextBox Style="{StaticResource FieldInput}" Text="{Binding VenceRegistro, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Vigente hasta (dd/mm/aaaa)" />
                      </Border>
                      <TextBlock Text="{Binding ErrorVence}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorVence, Converter={StaticResource TextoVisible}}" />
                      <TextBlock Text="dd/mm/aaaa" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Clase de riesgo" Style="{StaticResource FieldLabel}" />
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:FormularioEquipoViewModel.OpcionesClase}"
                                SelectedItem="{Binding Clase}" DisplayMemberPath="Texto" AutomationProperties.Name="Clase de riesgo" />
                      <TextBlock Text="{Binding ErrorClase}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorClase, Converter={StaticResource TextoVisible}}" />
                      <TextBlock Text="{Binding AyudaClase}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding AvisoVencimiento}" FontSize="13" Foreground="{DynamicResource Brush.WarningText}" TextWrapping="Wrap" Margin="0,8,0,0"
                             Visibility="{Binding AvisoVencimiento, Converter={StaticResource TextoVisible}}" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="¿Requiere calibración?" Style="{StaticResource FieldLabel}" />
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:FormularioEquipoViewModel.OpcionesCalibracion}"
                                SelectedItem="{Binding Calibracion}" DisplayMemberPath="Texto" AutomationProperties.Name="Requiere calibración" />
                      <TextBlock Text="{Binding AyudaCalibracion}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding RequiereCalibracion}">
                      <TextBlock Text="Periodicidad (meses)" Style="{StaticResource FieldLabel}" />
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorMeses}">
                        <TextBox Style="{StaticResource FieldInput}" Text="{Binding MesesCalibracion, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Periodicidad de calibración en meses" />
                      </Border>
                      <TextBlock Text="{Binding ErrorMeses}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorMeses, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                  </Grid>
                  <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Info}" Margin="0,16,0,0"
                          Visibility="{Binding Difiere, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Info}"
                                      Foreground="{DynamicResource Brush.InfoText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                      <StackPanel>
                        <TextBlock Text="Distinto del valor sugerido para el tipo" FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}" />
                        <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Quedará registrado en la bitácora. Usa el dato del registro sanitario del modelo o la indicación del fabricante." />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Ubicación y adquisición -->
              <Border Style="{StaticResource Section}" Margin="0,24,0,0">
                <StackPanel>
                  <TextBlock Text="UBICACIÓN Y ADQUISICIÓN" Style="{StaticResource Overline}" Margin="0,0,0,12" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Área" Style="{StaticResource FieldLabel}" />
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Ubicaciones}" SelectedItem="{Binding Ubicacion}"
                                DisplayMemberPath="Nombre" AutomationProperties.Name="Área" />
                      <TextBlock Text="{Binding ErrorUbicacion}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorUbicacion, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Proveedor" /><Run Text=" (opcional)" FontWeight="Normal" Foreground="{DynamicResource Brush.Text3}" />
                      </TextBlock>
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Proveedor}"
                                DisplayMemberPath="Nombre" AutomationProperties.Name="Proveedor (opcional)" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6">
                    <Run Text="Fecha de adquisición" /><Run Text=" (opcional)" FontWeight="Normal" Foreground="{DynamicResource Brush.Text3}" />
                  </TextBlock>
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorAdquisicion}" Width="284" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding FechaAdquisicion, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Fecha de adquisición (dd/mm/aaaa)" />
                  </Border>
                  <TextBlock Text="{Binding ErrorAdquisicion}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorAdquisicion, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
              </Border>

              <!-- Mantenimiento preventivo (CA-HU-002-06) -->
              <Border Style="{StaticResource Section}" Margin="0,24,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="MANTENIMIENTO PREVENTIVO" Style="{StaticResource Overline}" />
                  </DockPanel>
                  <TextBlock Text="Periodicidad del preventivo" Style="{StaticResource FieldLabel}" />
                  <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:FormularioEquipoViewModel.OpcionesPeriodicidad}"
                            SelectedItem="{Binding Periodicidad}" DisplayMemberPath="Texto" Width="284" HorizontalAlignment="Left"
                            AutomationProperties.Name="Periodicidad del preventivo" />
                  <TextBlock Text="Según el manual del fabricante." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Último mantenimiento preventivo" Style="{StaticResource FieldLabel}" />
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorUltimo}" IsEnabled="{Binding PideUltimo}">
                        <TextBox Style="{StaticResource FieldInput}" Text="{Binding UltimoPreventivo, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 AutomationProperties.Name="Último mantenimiento preventivo (dd/mm/aaaa)" />
                      </Border>
                      <TextBlock Text="{Binding ErrorUltimo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorUltimo, Converter={StaticResource TextoVisible}}" />
                      <CheckBox Style="{StaticResource Casilla}" Content="No se conoce" IsChecked="{Binding NoSeConoce}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Próximo preventivo" Style="{StaticResource FieldLabel}" />
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorProximo}">
                        <TextBox Style="{StaticResource FieldInput}" Text="{Binding ProximoPreventivo, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 AutomationProperties.Name="Próximo preventivo (dd/mm/aaaa)" />
                      </Border>
                      <TextBlock Text="{Binding ErrorProximo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorProximo, Converter={StaticResource TextoVisible}}" />
                      <TextBlock Text="{Binding AyudaProximo}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                  </Grid>
                  <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" Margin="0,16,0,0"
                          Visibility="{Binding PreventivoAtrasado, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.AlertaTriangulo}"
                                      Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="Preventivo atrasado" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Según el último mantenimiento, el preventivo ya debía hacerse. El plan quedará vencido desde hoy y aparecerá en las alertas para programarlo." />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                             Text="SITBIO no asigna técnicos al plan: la asignación del personal la decide la institución." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <!-- ================= RF-031 Agregar o cambiar fotografía (solo AC-02; prototipo FotoEquipo.tsx) ================= -->
    <Grid DataContext="{Binding Detalle.DialogoFoto}" Visibility="{Binding Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CancelarCommand}" />
      <Border Style="{StaticResource Dialog}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Titulo}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" Background="{DynamicResource Brush.PrimarySoft}">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Camara}" Foreground="{DynamicResource Brush.Primary}" />
            </Border>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center" />
          </StackPanel>

          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" Margin="0,16,0,0">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.AlertaTriangulo}"
                              Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}">
                <Run Text="Antes de subirla: " FontWeight="SemiBold" /><Run Text="{x:Static vm:FotoEquipoViewModel.AvisoDatosPersonales}" />
              </TextBlock>
            </DockPanel>
          </Border>

          <ContentControl Content="{Binding Aviso}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,16,0,0"
                          Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" />

          <DockPanel Margin="0,16,0,0">
            <Border DockPanel.Dock="Left" Width="160" Height="160" CornerRadius="14" Background="{DynamicResource Brush.Surface3}" Margin="0,0,16,0">
              <Grid>
                <TextBlock Text="Sin fotografía" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border CornerRadius="14" Visibility="{Binding HayVistaPrevia, Converter={StaticResource Visible}}" AutomationProperties.Name="Vista previa">
                  <Border.Background>
                    <ImageBrush ImageSource="{Binding VistaPrevia, Converter={StaticResource Imagen}}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <Button views:Boton.Icono="{StaticResource Icono.Camara}" Content="Elegir imagen…" Style="{StaticResource LinkButton}" Command="{Binding ElegirImagenCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding TextoPeso}" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,8,0,0"
                         Visibility="{Binding TextoPeso, Converter={StaticResource TextoVisible}}" />
              <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Visibility="{Binding Error, Converter={StaticResource TextoVisible}}" />
              <TextBlock Text="JPG, PNG o WebP de hasta 10 MB." Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" />
              <Button views:Boton.Icono="{StaticResource Icono.Papelera}" Content="Quitar fotografía" Style="{StaticResource LinkButton}" Foreground="{DynamicResource Brush.DangerText}" HorizontalAlignment="Left"
                      Margin="0,10,0,0" Command="{Binding QuitarCommand}" Visibility="{Binding PuedeQuitar, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>

          <CheckBox Style="{StaticResource Casilla}" IsChecked="{Binding AvisoAceptado}" Margin="0,16,0,0"
                    Content="Confirmo que la foto muestra solo el equipo, sin datos personales." />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0" IsCancel="True"
                    Command="{Binding CancelarCommand}" />
            <Button Content="Guardar fotografía" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= RF-031 Fotografía ampliada (512 px) ================= -->
    <Grid DataContext="{Binding Detalle}" Visibility="{Binding FotoAmpliada, Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CerrarFotoAmpliadaCommand}" />
      <Border Style="{StaticResource Dialog}" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Fotografía del equipo">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" FontSize="18">
            <Run Text="{Binding Titulo, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Placa, Mode=OneWay}" />
          </TextBlock>
          <Border CornerRadius="10" Background="{DynamicResource Brush.Surface3}" Margin="0,16,0,0">
            <Image Source="{Binding FotoAmpliada, Converter={StaticResource Imagen}}" MaxHeight="460" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Fotografía del equipo" />
          </Border>
          <TextBlock Text="Guardada a 512 px y 128 px; el original no se conserva." Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" />
          <Button Content="Cerrar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"
                  Command="{Binding CerrarFotoAmpliadaCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= RF-027 Hoja de vida en PDF: vista previa y «Guardar» (prototipo HojaVida.tsx) ================= -->
    <Grid DataContext="{Binding Detalle}" Visibility="{Binding VistaPreviaPdf, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CerrarHojaVidaPdfCommand}" />
      <Border Style="{StaticResource Dialog}" Width="720" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.Name="Hoja de vida en PDF">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" FontSize="18">
            <Run Text="Hoja de vida · " /><Run Text="{Binding Placa, Mode=OneWay}" />
          </TextBlock>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12"
                     Text="Vista previa con los datos de la hoja de vida. «Guardar PDF» genera el documento completo con el historial de intervenciones; la descarga queda en la bitácora." />
          <StackPanel DockPanel.Dock="Bottom">
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                    Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding AvisoPdf, Converter={StaticResource NuloVisible}}">
              <DockPanel>
                <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                                Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <StackPanel>
                  <TextBlock Text="{Binding AvisoPdf.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AvisoPdf.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <TextBlock Text="Generando…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                         Visibility="{Binding GenerandoPdf, Converter={StaticResource Visible}}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarHojaVidaPdfCommand}" IsCancel="True" Margin="0,0,20,0" />
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuardarHojaVidaPdfCommand}" IsDefault="True"
                      AutomationProperties.Name="Guardar la hoja de vida en PDF">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Descargar}" Width="16" Height="16" Margin="0,0,6,0" />
                  <TextBlock Text="Guardar PDF" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <Border Background="{DynamicResource Brush.Surface3}" CornerRadius="12" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <Border Background="White" CornerRadius="4" Padding="28,24" MaxWidth="620" AutomationProperties.Name="Vista previa de la hoja de vida">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" />
                </Border.Effect>
                <StackPanel TextElement.Foreground="#1F2A37">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                      <TextBlock Text="Código de activo" FontSize="10" Foreground="#5B6675" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Hoja de vida del equipo biomédico" FontSize="14" FontWeight="Bold" />
                      <TextBlock Text="{Binding Titulo}" FontSize="10.5" Foreground="#5B6675" />
                    </StackPanel>
                  </DockPanel>
                  <Border BorderBrush="#0B4F6C" BorderThickness="0,0,0,2" Margin="0,8,0,0" />
                  <Border BorderBrush="#B33636" BorderThickness="1.5" CornerRadius="4" Padding="10,6" Margin="0,10,0,0"
                          Visibility="{Binding EstaDeBaja, Converter={StaticResource Visible}}">
                    <TextBlock Text="EQUIPO DADO DE BAJA" Foreground="#B33636" FontWeight="Bold" FontSize="11" />
                  </Border>
                  <TextBlock Text="1. Identificación" FontWeight="Bold" FontSize="12" Foreground="#0B4F6C" Margin="0,14,0,6" />
                  <ItemsControl ItemsSource="{Binding DatosActivo}" ItemTemplate="{StaticResource DatoPdf}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock Text="2. Información técnica" FontWeight="Bold" FontSize="12" Foreground="#0B4F6C" Margin="0,14,0,6" />
                  <ItemsControl ItemsSource="{Binding InformacionTecnica}" ItemTemplate="{StaticResource DatoPdf}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock Text="3. Información regulatoria" FontWeight="Bold" FontSize="12" Foreground="#0B4F6C" Margin="0,14,0,6" />
                  <ItemsControl ItemsSource="{Binding InformacionRegulatoria}" ItemTemplate="{StaticResource DatoPdf}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock Text="4. Mantenimiento y calibración" FontWeight="Bold" FontSize="12" Foreground="#0B4F6C" Margin="0,14,0,6" />
                  <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,14,8">
                      <TextBlock Text="PRÓXIMO PREVENTIVO" FontSize="9.5" Foreground="#5B6675" />
                      <TextBlock Text="{Binding ProximoMantenimiento}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                      <TextBlock Text="CALIBRACIÓN" FontSize="9.5" Foreground="#5B6675" />
                      <TextBlock Text="{Binding Calibracion}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                      <TextBlock Text="ESTADO ACTUAL" FontSize="9.5" Foreground="#5B6675" />
                      <TextBlock Text="{Binding Estado}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock Text="El PDF agrega el historial de intervenciones y las calibraciones registradas." FontSize="10" Foreground="#5B6675"
                             TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ================= HU-015 Agregar documento (solo AC-02; prototipo HojaVida.tsx) ================= -->
    <Grid DataContext="{Binding Detalle.Documentos}" Visibility="{Binding Agregando, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CancelarAgregarCommand}" />
      <Border Style="{StaticResource Dialog}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Agregar documento">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" Background="{DynamicResource Brush.PrimarySoft}">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Documento}" Foreground="{DynamicResource Brush.Primary}" />
            </Border>
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center">
              <Run Text="Agregar documento · " /><Run Text="{Binding Placa, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>

          <ContentControl Content="{Binding AvisoFormulario}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,16,0,0"
                          Visibility="{Binding AvisoFormulario, Converter={StaticResource NuloVisible}}" />

          <TextBlock Text="Tipo de documento" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
          <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:DocumentosEquipoViewModel.Tipos}" SelectedItem="{Binding Tipo}"
                    AutomationProperties.Name="Tipo de documento" />
          <TextBlock Text="{Binding ErrorTipo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorTipo, Converter={StaticResource TextoVisible}}" />

          <TextBlock Text="Archivo" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
          <Border BorderThickness="1.5" CornerRadius="10" Padding="12,10" Background="{DynamicResource Brush.Surface3}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ErrorArchivo, Converter={StaticResource TextoVisible}}" Value="Visible">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Subir}" Foreground="{DynamicResource Brush.Text2}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button views:Boton.Icono="{StaticResource Icono.Subir}" DockPanel.Dock="Right" Content="Elegir archivo…" Style="{StaticResource LinkButton}" Command="{Binding ElegirArchivoCommand}" VerticalAlignment="Center" />
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0">
                <Run Text="{Binding NombreArchivo, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                <Run Text="{Binding TamanoArchivo, Mode=OneWay}" Foreground="{DynamicResource Brush.Text2}" />
              </TextBlock>
            </DockPanel>
          </Border>
          <TextBlock Text="PDF, JPG o PNG de hasta 10 MB." FontSize="13" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ErrorArchivo, Converter={StaticResource TextoVisible}}" Value="Visible">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding ErrorArchivo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorArchivo, Converter={StaticResource TextoVisible}}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0" IsCancel="True"
                    Command="{Binding CancelarAgregarCommand}" />
            <Button views:Boton.Icono="{StaticResource Icono.Clip}" Content="Adjuntar" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmarAgregarCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= HU-015 Desactivar documento (confirmación) ================= -->
    <Grid DataContext="{Binding Detalle.Documentos}" Visibility="{Binding PorDesactivar, Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CancelarDesactivarCommand}" />
      <Border Style="{StaticResource Dialog}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="¿Desactivar este documento?">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" Background="{DynamicResource Brush.DangerSoft}">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Papelera}" Foreground="{DynamicResource Brush.DangerText}" />
            </Border>
            <TextBlock Text="¿Desactivar este documento?" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding TextoDesactivar}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,20" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0" IsCancel="True"
                    Command="{Binding CancelarDesactivarCommand}" />
            <Button Content="Desactivar" Style="{StaticResource DangerButton}" Command="{Binding ConfirmarDesactivarCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= HU-014 Dar de baja o revertir la baja (solo AC-02; prototipo HojaVida.tsx) ================= -->
    <Grid x:Name="DialogoBaja" DataContext="{Binding Detalle}" Visibility="{Binding Baja, Converter={StaticResource NuloVisible}, FallbackValue=Collapsed}">
      <Button Style="{StaticResource Velo}" Command="{Binding CancelarBajaCommand}" />
      <Border Style="{StaticResource Dialog}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Baja}"
              AutomationProperties.Name="{Binding Titulo}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <!-- Rojo al dar de baja; verde al revertir (no es destructiva) -->
            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerText}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EsReversion}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Primary}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Equipo}" />
            </Border>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="400" />
          </StackPanel>

          <ContentControl Content="{Binding Aviso}" ContentTemplate="{StaticResource PlantillaAviso}" Focusable="False" Margin="0,16,0,0"
                          Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" />

          <!-- Motivo de la baja -->
          <StackPanel Visibility="{Binding EsBaja, Converter={StaticResource Visible}}" Margin="0,16,0,0">
            <TextBlock Text="Motivo de la baja" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding Opciones}" Focusable="False" Margin="0,4,0,0" AutomationProperties.Name="Motivo de la baja">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:OpcionMotivo}">
                  <RadioButton Style="{StaticResource OpcionRadio}" GroupName="MotivoBaja" Content="{Binding Texto}" IsChecked="{Binding Elegida}" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ErrorMotivo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorMotivo, Converter={StaticResource TextoVisible}}" />
          </StackPanel>

          <TextBlock Text="{Binding EtiquetaObservacion}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
          <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorObservacion}">
            <TextBox Style="{StaticResource FieldInput}" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Height="76" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="300"
                     AutomationProperties.Name="{Binding EtiquetaObservacion}" />
          </Border>
          <TextBlock Text="{Binding ErrorObservacion}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorObservacion, Converter={StaticResource TextoVisible}}" />

          <!-- Qué pasará -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" Margin="0,16,0,0">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.AlertaTriangulo}"
                              Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
              <StackPanel>
                <TextBlock Text="Qué pasará" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
                <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding EsBaja, Converter={StaticResource Visible}}"
                           Text="El equipo sale del inventario activo, de los indicadores y del límite del plan. Su hoja de vida y su historial se conservan, y la baja se puede revertir." />
                <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Visibility="{Binding EsReversion, Converter={StaticResource Visible}}"
                           Text="El equipo vuelve al inventario activo como «Operativo» y cuenta otra vez en el límite de equipos del plan." />
              </StackPanel>
            </DockPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0" IsCancel="True"
                    Command="{Binding DataContext.CancelarBajaCommand, ElementName=DialogoBaja}" />
            <Button Content="Dar de baja" Style="{StaticResource DangerButton}" Visibility="{Binding EsBaja, Converter={StaticResource Visible}}"
                    Command="{Binding DataContext.ConfirmarBajaCommand, ElementName=DialogoBaja}" />
            <Button views:Boton.Icono="{StaticResource Icono.Revertir}" Content="Revertir baja" Style="{StaticResource PrimaryButton}" Visibility="{Binding EsReversion, Converter={StaticResource Visible}}"
                    Command="{Binding DataContext.ConfirmarBajaCommand, ElementName=DialogoBaja}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
