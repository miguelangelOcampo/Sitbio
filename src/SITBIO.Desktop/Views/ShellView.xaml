<!-- Marco de la sesión: riel con nombres (78 px) + panel agrupado (200 px) + área principal
     (prototipo vigente, menú «riel con nombres y panel agrupado»). El riel no lleva logo. -->
<UserControl x:Class="Sitbio.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:RecursoConverter x:Key="Recurso" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
      <views:UsuariosView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EquiposViewModel}">
      <views:EquiposView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BitacoraViewModel}">
      <views:BitacoraView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportarFallaViewModel}">
      <views:ReportarFallaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SeguimientoViewModel}">
      <views:SeguimientoView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BandejaViewModel}">
      <views:BandejaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConfiguracionViewModel}">
      <views:ConfiguracionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MantenimientosViewModel}">
      <views:MantenimientosView />
    </DataTemplate>

    <!-- Tarjeta de alerta de UI-016: estado con punto y texto (ACC-001); la revisada se atenúa. -->
    <Style x:Key="PuntoAlerta" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="TarjetaAlerta" DataType="{x:Type vm:FilaAlerta}">
      <Border x:Name="Tarjeta" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Field}"
              Padding="14,12" Margin="0,0,0,10" Background="{DynamicResource Brush.Surface}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Fecha}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Tipo}" Style="{StaticResource Overline}" />
          </DockPanel>
          <TextBlock Text="{Binding Equipo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Equipo}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Descripcion}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Ellipse Style="{StaticResource PuntoAlerta}" />
            <TextBlock Text="{Binding Estado}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="· Revisada" Foreground="{DynamicResource Brush.Text2}" Margin="6,0,0,0"
                       Visibility="{Binding Revisada, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock Text="{Binding Orden}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" Margin="0,4,0,0"
                     Visibility="{Binding Orden, Converter={StaticResource TextoVisible}}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Abrir" Style="{StaticResource LinkButton}" Margin="0,0,18,0"
                    Command="{Binding DataContext.AbrirAlertaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Equipo, StringFormat='Abrir la alerta de {0}'}" />
            <Button Content="Marcar como revisada"
                    Command="{Binding DataContext.MarcarRevisadaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Equipo, StringFormat='Marcar como revisada la alerta de {0}'}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Revisada}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Revisada}" Value="True">
          <Setter TargetName="Tarjeta" Property="Opacity" Value="0.62" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanelMuted}" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTecladoRiel}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" Margin="16,0" CornerRadius="10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="78" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Riel de módulos -->
    <Grid Grid.Column="0" Background="{DynamicResource Brush.BrandPanel}" ClipToBounds="True">
      <Ellipse Width="190" Height="190" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-95,0,0,-70"
               Stroke="{DynamicResource Brush.BrandRing}" StrokeThickness="1" Opacity="0.26" IsHitTestVisible="False" />
      <DockPanel Margin="0,14,0,12">
        <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}"
                Command="{Binding AlternarPanelCommand}" AutomationProperties.Name="Mostrar u ocultar el panel">
          <ContentControl Width="18" Height="18">
            <ContentControl.Style>
              <Style TargetType="ContentControl" BasedOn="{StaticResource Icono}">
                <Setter Property="Content" Value="{StaticResource Icono.OcultarPanel}" />
                <Setter Property="ToolTip" Value="Ocultar panel" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PanelVisible}" Value="False">
                    <Setter Property="Content" Value="{StaticResource Icono.MostrarPanel}" />
                    <Setter Property="ToolTip" Value="Mostrar panel" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </Button>
        <!-- Campana del centro de alertas (UI-016), con el número de alertas sin revisar -->
        <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Margin="0,0,0,6" DataContext="{Binding Alertas}"
                Command="{Binding AlternarCommand}" ToolTip="{Binding TextoPendientes}"
                AutomationProperties.Name="{Binding TextoPendientes, StringFormat='Centro de alertas: {0}'}"
                Visibility="{Binding DataContext.TieneAlertas, RelativeSource={RelativeSource AncestorType=views:ShellView}, Converter={StaticResource Visible}}">
          <Grid>
            <ContentControl Style="{StaticResource Icono}" Width="20" Height="20" Content="{StaticResource Icono.Campana}" />
            <Border Background="{DynamicResource Brush.Danger}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-11,0"
                    Visibility="{Binding HayPendientes, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Pendientes}" FontSize="10" FontWeight="SemiBold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
        <ItemsControl ItemsSource="{Binding Modulos}" Focusable="False" AutomationProperties.Name="Módulos">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ModuloViewModel}">
              <RadioButton Style="{StaticResource RailItem}" GroupName="Riel" ToolTip="{Binding Nombre}"
                           IsChecked="{Binding EnPanel, Mode=OneWay}" Tag="{Binding EsActivo}"
                           Command="{Binding DataContext.AbrirModuloCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}" AutomationProperties.Name="{Binding Nombre}">
                <Grid>
                  <StackPanel>
                    <ContentControl Style="{StaticResource Icono}" Width="22" Height="22" HorizontalAlignment="Center"
                                    Content="{Binding Icono, Converter={StaticResource Recurso}}" />
                    <TextBlock Text="{Binding Corto}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                  </StackPanel>
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Danger}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,-2,-6,0" Visibility="{Binding TienePendientes, Converter={StaticResource Visible}}" />
                </Grid>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Grid>

    <!-- Panel agrupado del módulo -->
    <Border Grid.Column="1" Style="{StaticResource NavPanel}" Visibility="{Binding PanelVisible, Converter={StaticResource Visible}}">
      <DockPanel Margin="0,22,0,14">
        <StackPanel DockPanel.Dock="Bottom">
          <!-- Sesión: rol y «Cerrar sesión» (HU-012) -->
          <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="12,0,8,10" Padding="8,10,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding PedirCierreCommand}"
                      AutomationProperties.Name="Cerrar sesión" ToolTip="Cerrar sesión">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Salir}" Width="17" Height="17" />
              </Button>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding NombreRol}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Rol}" FontSize="12" Foreground="{DynamicResource Brush.Text3}" />
                <!-- UI-002 voluntario (HU-013); pasará a «Mi perfil» cuando exista -->
                <Button Content="Cambiar contraseña" Style="{StaticResource LinkButton}" FontSize="12" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding AbrirCambioClaveCommand}" Visibility="{Binding PuedeCambiarClave, Converter={StaticResource Visible}}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="20,0">
            <Image Source="{DynamicResource Logo.Iso}" Height="22" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="SITBIO v1.0" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,0,16,10">
          <TextBlock Text="{Binding ModuloEnPanel.Nombre}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
          <Border Style="{StaticResource FieldBox}" MinHeight="34" Margin="0,12,0,0" Padding="10,0"
                  Visibility="{Binding MostrarBuscador, Converter={StaticResource Visible}}">
            <DockPanel>
              <ContentControl Style="{StaticResource Icono}" Width="14" Height="14" Content="{StaticResource Icono.Buscar}" Margin="0,0,8,0" />
              <TextBox Style="{StaticResource FieldInput}" FontSize="13" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{Binding TextoBuscador}" ToolTip="{Binding TextoBuscador}" />
            </DockPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding GruposPanel}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GrupoOpciones}">
                <StackPanel Margin="0,4,0,8">
                  <TextBlock Text="{Binding Titulo}" Style="{StaticResource Overline}" Margin="20,8,0,4"
                             Visibility="{Binding Titulo, Converter={StaticResource TextoVisible}}" />
                  <ItemsControl ItemsSource="{Binding Opciones}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:OpcionViewModel}">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Opciones" Content="{Binding Etiqueta}"
                                     IsChecked="{Binding EsActual, Mode=OneWay}"
                                     Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=views:ShellView}}"
                                     CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Área principal con anillos de fondo (detrás del contenido, sin interacción) -->
    <Grid Grid.Column="2" ClipToBounds="True">
      <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-230,-210,0"
               Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1" Opacity="0.13" IsHitTestVisible="False" />
      <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-120,0"
               Stroke="{DynamicResource Brush.Action}" StrokeThickness="1" Opacity="0.32" IsHitTestVisible="False" />
      <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-420"
               Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1" Opacity="0.13" IsHitTestVisible="False" />

      <!-- Pantalla de la opción actual (DataTemplate por ViewModel) -->
      <ContentControl Content="{Binding Contenido}" Focusable="False" />

      <!-- UI-016 Centro de alertas: panel lateral sobre el área principal (NAV-011: abrir una alerta lo cierra) -->
      <Border HorizontalAlignment="Right" Width="380" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1,0,0,0" DataContext="{Binding Alertas}" AutomationProperties.Name="Centro de alertas"
              Visibility="{Binding Abierto, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="24,24,24,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CerrarCommand}"
                      AutomationProperties.Name="Cerrar el centro de alertas" VerticalAlignment="Top">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
              </Button>
              <TextBlock Text="ALERTAS" Style="{StaticResource Overline}" />
            </DockPanel>
            <TextBlock Text="Centro de alertas" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,4,0,0" />
            <TextBlock Text="{Binding TextoAnticipacion}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Cargado, Converter={StaticResource Visible}}" />
            <DockPanel Margin="0,12,0,0">
              <Button DockPanel.Dock="Right" Content="Marcar todas como revisadas" Style="{StaticResource LinkButton}" FontSize="13"
                      Command="{Binding MarcarTodasRevisadasCommand}" Visibility="{Binding HayPendientes, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding TextoPendientes}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                    Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
              <StackPanel>
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                    Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                    Visibility="{Binding OrdenesGeneradas, Converter={StaticResource TextoVisible}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarOrdenesGeneradasCommand}"
                        VerticalAlignment="Top" Margin="12,0,0,0" />
                <TextBlock Text="{Binding OrdenesGeneradas}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <TextBlock Text="Consultando las alertas…" Style="{StaticResource Muted}" Margin="0,12,0,0"
                       Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
            <StackPanel Margin="0,16,0,0" Visibility="{Binding SinAlertas, Converter={StaticResource Visible}}">
              <TextBlock Text="No hay mantenimientos ni calibraciones por vencer." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
              <TextBlock Text="Cuando uno entre en los días de anticipación de tu institución, aparecerá aquí." Style="{StaticResource Muted}"
                         TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Filas}" ItemTemplate="{StaticResource TarjetaAlerta}" Margin="24,0,24,24" Focusable="False"
                          AutomationProperties.Name="Alertas de vencimiento" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Confirmación breve del marco (por ejemplo, «Contraseña actualizada») -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="460" Margin="0,0,32,28"
              AutomationProperties.LiveSetting="Polite" Visibility="{Binding Confirmacion, Converter={StaticResource TextoVisible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarConfirmacionCommand}"
                  VerticalAlignment="Top" Margin="16,0,0,0" />
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}" Foreground="{DynamicResource Brush.SuccessText}"
                          VerticalAlignment="Top" Margin="0,1,10,0" />
          <TextBlock Text="{Binding Confirmacion}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <StackPanel Margin="40,36" MaxWidth="760" HorizontalAlignment="Left"
                  Visibility="{Binding EnConstruccion, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding TituloModuloActual}" Style="{StaticResource Overline}" />
        <TextBlock Text="{Binding OpcionActual.Etiqueta}" Style="{StaticResource PageTitle}" Margin="0,6,0,24" />
        <Border Style="{StaticResource Section}">
          <StackPanel>
            <TextBlock Text="Pantalla en construcción" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
              <Run Text="{Binding OpcionActual.Opcion.Id, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text="llega con su historia de usuario. La navegación y los permisos ya responden a tu rol" />
              <Run Text="{Binding Rol, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Confirmar el cierre de sesión (CA-HU-012-02) -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding ConfirmandoCierre, Converter={StaticResource Visible}}">
      <Button Style="{StaticResource Velo}" Command="{Binding CancelarCierreCommand}" />
      <Border Style="{StaticResource Dialog}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="¿Cerrar sesión?" Style="{StaticResource SectionTitle}" FontSize="18" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,20"
                     Text="Tu token se invalida y tendrás que iniciar sesión de nuevo. Lo que guardaste se conserva." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,24,0"
                    Command="{Binding CancelarCierreCommand}" IsCancel="True" />
            <Button Content="Cerrar sesión" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmarCierreCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- UI-002 voluntario (HU-013) -->
    <Grid Grid.ColumnSpan="3" Visibility="{Binding CambioClave, Converter={StaticResource NuloVisible}}">
      <Button Style="{StaticResource Velo}" Command="{Binding CambioClave.CancelarCommand}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <views:CambioClaveView DataContext="{Binding CambioClave}" Margin="24" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
