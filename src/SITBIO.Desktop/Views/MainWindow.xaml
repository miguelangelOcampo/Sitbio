<Window x:Class="Sitbio.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
        xmlns:views="clr-namespace:Sitbio.Desktop.Views"
        Title="{Binding Titulo}"
        Icon="{DynamicResource Logo.Iso}"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
      <views:LoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}">
      <views:ShellView />
    </DataTemplate>
  </Window.Resources>
  <ContentControl Content="{Binding VistaActual}" Focusable="False" />
</Window>
