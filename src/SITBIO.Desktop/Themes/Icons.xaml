<!-- Íconos de trazo sobre una cuadrícula de 24 × 24 (trazo 1.7, color = Foreground).
     Uso: <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Correo}" /> -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Geometry x:Key="Icono.Correo">M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M22,7 L12,13 L2,7</Geometry>
  <Geometry x:Key="Icono.Candado">M5,11 H19 A2,2 0 0 1 21,13 V20 A2,2 0 0 1 19,22 H5 A2,2 0 0 1 3,20 V13 A2,2 0 0 1 5,11 Z M7,11 V7 A5,5 0 0 1 17,7 V11</Geometry>
  <Geometry x:Key="Icono.Ojo">M2,12 C2,12 5,5 12,5 C19,5 22,12 22,12 C22,12 19,19 12,19 C5,19 2,12 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z</Geometry>
  <Geometry x:Key="Icono.OjoTachado">M2,12 C2,12 5,5 12,5 C19,5 22,12 22,12 C22,12 19,19 12,19 C5,19 2,12 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z M3,3 L21,21</Geometry>
  <Geometry x:Key="Icono.FlechaDerecha">M5,12 H19 M12,5 L19,12 L12,19</Geometry>
  <Geometry x:Key="Icono.Alerta">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,8 V12 M12,16 H12.01</Geometry>
  <Geometry x:Key="Icono.Info">M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 Z M12,16 V12 M12,8 H12.01</Geometry>

  <Geometry x:Key="Icono.Buscar">M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 Z M21,21 L16,16</Geometry>
  <Geometry x:Key="Icono.OcultarPanel">M11,17 L6,12 L11,7 M18,17 L13,12 L18,7</Geometry>
  <Geometry x:Key="Icono.MostrarPanel">M13,17 L18,12 L13,7 M6,17 L11,12 L6,7</Geometry>

  <!-- Íconos propios del riel (prototipo: BioIcons.tsx); retoman el hexágono y el pulso del logo -->
  <!-- Inicio: hexágono con pulso -->
  <Geometry x:Key="Icono.Riel.Inicio">M12,2.8 L20,7.4 V16.6 L12,21.2 L4,16.6 V7.4 Z M7.2,12.4 H9.5 L10.9,9.5 L13.1,14.8 L14.6,12.4 H16.8</Geometry>
  <!-- Gestión: monitor de signos vitales sobre su soporte -->
  <Geometry x:Key="Icono.Riel.Gestion">M5.2,4 H18.8 A2.2,2.2 0 0 1 21,6.2 V13.8 A2.2,2.2 0 0 1 18.8,16 H5.2 A2.2,2.2 0 0 1 3,13.8 V6.2 A2.2,2.2 0 0 1 5.2,4 Z M6.2,10.6 H8.8 L10.1,8.3 L12.1,12.9 L13.5,10.6 H17.8 M12,16 V19.2 M8.5,20.2 H15.5</Geometry>
  <!-- Solicitudes: tiquete con cruz médica -->
  <Geometry x:Key="Icono.Riel.Solicitudes">M4,7.2 A2.2,2.2 0 0 1 6.2,5 H17.8 A2.2,2.2 0 0 1 20,7.2 V9.5 A2.5,2.5 0 0 0 20,14.5 V16.8 A2.2,2.2 0 0 1 17.8,19 H6.2 A2.2,2.2 0 0 1 4,16.8 V14.5 A2.5,2.5 0 0 0 4,9.5 Z M12,9.6 V14.4 M9.6,12 H14.4</Geometry>
  <!-- Análisis: barras con línea de tendencia y punto actual -->
  <Geometry x:Key="Icono.Riel.Analisis">M4,4 V20 H20 M8.5,16.5 V13.5 M12.5,16.5 V11 M16.5,16.5 V12.5 M7.5,9.5 L11,7 L14,8.8 L17,6.2 M16.9,5.8 A0.7,0.7 0 1 0 18.3,5.8 A0.7,0.7 0 1 0 16.9,5.8 Z</Geometry>
  <!-- Admin: escudo con cerradura -->
  <Geometry x:Key="Icono.Riel.Admin">M12,3.2 L19,6 V11.2 C19,15.5 16.1,18.9 12,20.8 C7.9,18.9 5,15.5 5,11.2 V6 Z M10,10.6 A2,2 0 1 0 14,10.6 A2,2 0 1 0 10,10.6 Z M12,12.6 V15.6</Geometry>

  <Style x:Key="Icono" TargetType="ContentControl">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Viewbox>
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
