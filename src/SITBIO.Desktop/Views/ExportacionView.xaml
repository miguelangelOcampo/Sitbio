<!-- UI-022 Exportación (HU-007, HU-027): historial de órdenes en PDF o Excel y hoja de vida del equipo en PDF. -->
<UserControl x:Class="Sitbio.Desktop.Views.ExportacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sitbio.Desktop.Controls"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <TextBlock Text="ANÁLISIS" Style="{StaticResource Overline}" />
      <TextBlock Text="Exportación de reportes" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                 Text="Genera reportes en PDF o Excel para auditorías, comités y entes de control: el historial de órdenes de trabajo o la hoja de vida de un equipo." />

      <!-- Error -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}" Margin="0,0,0,16"
              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
        <DockPanel>
          <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                          Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel>
            <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" />
            <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Guardado -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}" Margin="0,0,0,16"
              Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}}">
        <DockPanel>
          <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.CheckCirculo}"
                          Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel>
            <TextBlock Text="{Binding Confirmacion.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" />
            <TextBlock Text="{Binding Confirmacion.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Historial de órdenes -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,16" Visibility="{Binding PuedeExportarHistorial, Converter={StaticResource Visible}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Historial de órdenes de trabajo" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Desde (dd/mm/aaaa)" Style="{StaticResource FieldLabel}" />
              <Border Style="{StaticResource FieldBox}">
                <controls:CampoFecha Text="{Binding Desde, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Desde" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Hasta (dd/mm/aaaa)" Style="{StaticResource FieldLabel}" />
              <Border Style="{StaticResource FieldBox}">
                <controls:CampoFecha Text="{Binding Hasta, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hasta" />
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="Formato" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:ExportacionViewModel.Formatos}" SelectedItem="{Binding Formato}"
                        DisplayMemberPath="Texto" AutomationProperties.Name="Formato" />
            </StackPanel>
            <Button views:Boton.Icono="{StaticResource Icono.Descargar}" Grid.Column="6" Style="{StaticResource PrimaryButton}" Content="Exportar" Command="{Binding ExportarHistorialCommand}"
                    IsEnabled="{Binding Libre}" VerticalAlignment="Bottom" />
          </Grid>
          <TextBlock Text="{Binding ErrorFechas}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorFechas, Converter={StaticResource TextoVisible}}" />
        </StackPanel>
      </Border>

      <!-- Hoja de vida -->
      <Border Style="{StaticResource Section}">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Hoja de vida del equipo" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="560" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Equipo" Style="{StaticResource FieldLabel}" />
              <Border Style="{StaticResource FieldBox}">
                <DockPanel>
                  <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Buscar}" Width="16" Height="16" Margin="0,0,8,0"
                                  Foreground="{DynamicResource Brush.Text3}" />
                  <Grid>
                    <TextBlock Text="Placa, serie o nombre del equipo" Foreground="{DynamicResource Brush.Text3}" FontSize="15" VerticalAlignment="Center"
                               Margin="2,0,0,0" IsHitTestVisible="False" Visibility="{Binding SinPlaca, Converter={StaticResource Visible}}" />
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Buscar el equipo por placa, serie o nombre">
                      <TextBox.InputBindings>
                        <KeyBinding Key="Down" Command="{Binding SugerenciaSiguienteCommand}" />
                        <KeyBinding Key="Up" Command="{Binding SugerenciaAnteriorCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding ElegirEquipoCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CerrarSugerenciasCommand}" />
                      </TextBox.InputBindings>
                    </TextBox>
                  </Grid>
                </DockPanel>
              </Border>
            </StackPanel>
            <Button views:Boton.Icono="{StaticResource Icono.Reporte}" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Generar PDF" Command="{Binding GenerarHojaVidaCommand}"
                    IsEnabled="{Binding Libre}" VerticalAlignment="Bottom" />
          </Grid>
          <TextBlock Text="Escribe al menos dos caracteres; usa las flechas y Enter para elegir." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />

          <!-- Sugerencias mientras se escribe (I-08) -->
          <TextBlock Text="Buscando…" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"
                     Visibility="{Binding BuscandoEquipo, Converter={StaticResource Visible}}" />
          <TextBlock Text="No hay equipos con esa placa, serie o nombre en tu institución." Style="{StaticResource Muted}" Margin="0,10,0,0"
                     AutomationProperties.LiveSetting="Polite" Visibility="{Binding SinResultados, Converter={StaticResource Visible}}" />
          <Border Width="560" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="6" CornerRadius="10" BorderThickness="1"
                  Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}"
                  Visibility="{Binding HaySugerencias, Converter={StaticResource Visible}}">
            <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding Sugerido, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                     Focusable="False" MaxHeight="340" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Equipos sugeridos">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding PlacaInventario}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Fila" CornerRadius="6" Padding="10,7" Background="Transparent" Cursor="Hand">
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.ElegirEquipoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </Border.InputBindings>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding NumeroSerie, StringFormat='Serie {0}'}" FontSize="12"
                                 Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center" Margin="10,0,0,0" />
                      <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="14">
                        <Run Text="{Binding PlacaInventario, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <Run Text=" · " Foreground="{DynamicResource Brush.Text3}" />
                        <Run Text="{Binding TipoEquipo, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                        <Run Text=" · " Foreground="{DynamicResource Brush.Text3}" />
                        <Run Text="{Binding Ubicacion, Mode=OneWay}" Foreground="{DynamicResource Brush.Text3}" />
                      </TextBlock>
                    </DockPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Fila" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Fila" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="Fila" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding EquipoElegido, Converter={StaticResource NuloVisible}}">
            <Run Text="Equipo elegido:" />
            <Run Text="{Binding EquipoElegido.PlacaInventario, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="·" />
            <Run Text="{Binding EquipoElegido.TipoEquipo, Mode=OneWay}" />
            <Run Text="·" />
            <Run Text="{Binding EquipoElegido.Ubicacion, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
