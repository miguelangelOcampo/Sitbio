<!-- Estilos de los componentes (DOC-05) con el concepto «clínico editorial»:
     las secciones se separan con líneas finas y espacio, no con tarjetas.
     Las cajas con borde completo quedan solo para diálogos, menús y campos. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Foco visible solo con teclado (FocusVisualStyle): anillo de 2 px alrededor del control -->
  <Style x:Key="FocoTeclado">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Brush.Focus}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocoTecladoRiel">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="8,3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.BrandRing}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sección abierta: línea fina arriba y aire; reemplaza a la tarjeta -->
  <Style x:Key="Section" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,14,0,0" />
  </Style>

  <!-- Diálogo o menú: único caso con caja completa -->
  <Style x:Key="Dialog" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Space.6}" />
  </Style>

  <!-- Tipografía -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <!-- Etiqueta pequeña: escribir el texto en MAYÚSCULAS -->
  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Franja de indicadores: contenedor con líneas arriba y abajo; cada indicador separado por una línea vertical -->
  <Style x:Key="KpiStrip" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
  </Style>
  <Style x:Key="KpiItem" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="20,14" />
  </Style>
  <Style x:Key="KpiValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- Estado: punto de color + texto (sin pastilla). Ej.: <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Success}" /> -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Fila de lista con divisor inferior (tiquetes, técnicos, alertas) -->
  <Style x:Key="ListRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,12" />
  </Style>

  <!-- Opción del menú lateral: sin píldora; la activa lleva una barra a la izquierda -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" MinHeight="38">
            <Border x:Name="Barra" Width="3" HorizontalAlignment="Left" Margin="0,7" CornerRadius="0,2,2,0"
                    Background="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
            <ContentPresenter Margin="20,8,12,8" VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campo de formulario: etiqueta arriba, caja con borde completo (permitido en campos),
       foco visible de 2 px y mensaje de error debajo -->
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="FieldBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Field}" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text3}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,0" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FieldInput" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="FieldPassword" TargetType="PasswordBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="FieldError" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- Botón principal: verde de marca, texto blanco; foco con anillo exterior -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Tag" Value="{DynamicResource Brush.PrimaryHover}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Button}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.7" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Acción destructiva confirmada en un diálogo (Desactivar); Tag = color al pasar el mouse -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Tag" Value="{DynamicResource Brush.DangerText}" />
  </Style>

  <!-- Acción secundaria como enlace de texto -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Background="Transparent" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botón de ícono dentro de un campo (Mostrar/Ocultar) -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Fondo" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Aviso en línea: fondo suave y barra a la izquierda, sin caja completa.
       Error: <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"> -->
  <Style x:Key="InfoBar" TargetType="Border">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="14,11" />
  </Style>

  <!-- Riel de módulos (78 px, fondo de marca): ícono + nombre corto. IsChecked = módulo abierto en el panel;
       Tag = True para el módulo de la pantalla actual (barra lima a la izquierda). -->
  <Style x:Key="RailItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanelMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTecladoRiel}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Fondo" Margin="8,3" CornerRadius="10" Background="{DynamicResource Brush.OnBrandPanel}" Opacity="0" />
            <Border x:Name="Barra" Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="0,2,2,0"
                    Background="{DynamicResource Brush.BrandRing}" Visibility="Collapsed" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.08" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fondo" Property="Opacity" Value="0.12" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value>
                <sys:Boolean>True</sys:Boolean>
              </Trigger.Value>
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrandPanel}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Panel de navegación (200 px, claro) junto al riel: nombre del módulo, buscador y opciones -->
  <Style x:Key="NavPanel" TargetType="Border">
    <Setter Property="Width" Value="200" />
    <Setter Property="Background" Value="{DynamicResource Brush.Nav}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Pestaña: texto con barra inferior en la activa (sin caja) -->
  <Style x:Key="Pestana" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="0,0,28,0">
            <ContentPresenter Margin="0,10,0,12" />
            <Border x:Name="Barra" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Barra" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lista desplegable de formulario: caja como FieldBox y opciones en un menú -->
  <Style x:Key="FieldComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Fondo" Background="Transparent" Padding="12,8" CornerRadius="6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldCombo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Borde" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderControl}"
                          BorderThickness="1" CornerRadius="{StaticResource Radius.Field}" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Brush.Text2}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="Foco" BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="2" CornerRadius="{StaticResource Radius.Field}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
            <ContentPresenter Margin="13,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Chevron}" Width="16" Height="16"
                            HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text2}" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Field}" Padding="4" Margin="0,4,0,0" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menú de acciones de una fila (caja permitida en menús) -->
  <Style x:Key="MenuFilaItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Fondo" Background="Transparent" Padding="14,9" CornerRadius="6">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuFila" TargetType="ContextMenu">
    <Setter Property="ItemContainerStyle" Value="{StaticResource MenuFilaItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  CornerRadius="{StaticResource Radius.Field}" Padding="4" MinWidth="200">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabla abierta: sin marco, solo divisores horizontales -->
  <Style x:Key="OpenGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="13,10,14,10" />
  </Style>
  <!-- Fila: la seleccionada lleva una barra a la izquierda, sin relleno de color -->
  <Style x:Key="OpenGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OpenGridCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <ContentPresenter Margin="10,0,14,0" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="OpenGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource OpenGridHeader}" />
    <Setter Property="RowStyle" Value="{StaticResource OpenGridRow}" />
    <Setter Property="CellStyle" Value="{StaticResource OpenGridCell}" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
  </Style>
</ResourceDictionary>
