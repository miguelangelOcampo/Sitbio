<!-- UI-012 «Mis órdenes» / «Órdenes de trabajo» (HU-004, HU-005). Lista de órdenes de la más urgente a la
     menos urgente; el técnico inicia, pausa o reanuda cada una y abre su intervención (UI-013), que
     reemplaza la lista mientras está abierta. Prioridad y estado van con punto y texto, no solo color
     (ACC-001). -->
<UserControl x:Class="Sitbio.Desktop.Views.OrdenesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <DataTemplate DataType="{x:Type vm:IntervencionViewModel}">
      <views:IntervencionView />
    </DataTemplate>

    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PuntoPrioridad" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoPrioridad}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TonoPrioridad}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- UI-013 Intervención -->
    <ContentControl Content="{Binding Intervencion}" Focusable="False" IsTabStop="False"
                    Visibility="{Binding Intervencion, Converter={StaticResource NuloVisible}}" />

    <!-- UI-012 Lista -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  Visibility="{Binding EnLista, Converter={StaticResource Visible}}">
      <StackPanel Margin="40,24,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Confirmación -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding Exito, Converter={StaticResource TextoVisible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarExitoCommand}" Margin="16,0,0,0" />
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                            Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <TextBlock Text="{Binding Exito}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <TextBlock Text="TRABAJO" Style="{StaticResource Overline}" />
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource PageTitle}" Margin="0,4,0,6" />
        <TextBlock Text="{Binding Descripcion}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <TextBlock Text="Estado" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Style="{StaticResource FieldCombo}" Width="220" ItemsSource="{x:Static vm:OrdenesViewModel.OpcionesEstado}"
                    SelectedItem="{Binding Estado}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por estado" />
        </StackPanel>

        <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58"
                  AutomationProperties.Name="Órdenes de trabajo" ScrollViewer.CanContentScroll="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="PRIORIDAD" Width="0.9*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoPrioridad}" />
                    <TextBlock Text="{Binding Prioridad}" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="TIQUETE" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <StackPanel>
                    <TextBlock Text="{Binding Referencia}" FontFamily="Consolas" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Programada}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <StackPanel>
                    <TextBlock Text="{Binding Equipo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                    <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="FALLA" Width="1.2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <TextBlock Text="{Binding Falla}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Falla}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO" Width="1.2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoEstado}" />
                      <TextBlock Text="{Binding Estado}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Intervencion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="1.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaOrden}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding TextoIniciar}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                            Visibility="{Binding PuedeIniciar, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.IniciarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Referencia, StringFormat='Iniciar la orden {0}'}" />
                    <Button Content="Pausar" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                            Visibility="{Binding PuedePausar, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.PausarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Referencia, StringFormat='Pausar la orden {0}'}" />
                    <Button Content="{Binding TextoIntervencion}" Style="{StaticResource LinkButton}"
                            Visibility="{Binding MuestraIntervencion, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.AbrirIntervencionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Referencia, StringFormat='Intervención de la orden {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Consultando las órdenes…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding TextoSinOrdenes}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,24,0,0"
                   Visibility="{Binding SinOrdenes, Converter={StaticResource Visible}}" />

        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Actualizar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,20,0" />
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
