<!-- «Planes de SITBIO» (HU-028, RF-029; J-04 como el prototipo): diálogo sobre UI-001 que compara los cuatro planes en
     tarjetas, abre la solicitud de demostración o cotización con el plan elegido y, al enviarla, muestra el código de la
     solicitud (MSG-021). -->
<UserControl x:Class="Sitbio.Desktop.Views.SolicitudServicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <Style x:Key="CampoValidado" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Clave" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="Valor" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Button Style="{StaticResource Velo}" Command="{Binding CerrarCommand}" />
    <Border Style="{StaticResource Dialog}" Padding="0" MaxWidth="900" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Titulo}">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="24,20,16,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" AutomationProperties.Name="Cerrar" Command="{Binding CerrarCommand}">
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
          </Button>
          <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.ListaCheck}"
                          Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Text="{Binding Titulo}" Style="{StaticResource SectionTitle}" FontSize="20" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Pie de cada paso -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,14">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding VerPlanes, Converter={StaticResource Visible}}">
              <Button Content="Cerrar" Style="{StaticResource BotonSecundario}" Margin="0,0,12,0" Command="{Binding CerrarCommand}" />
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding IrAFormularioCommand}" AutomationProperties.Name="Solicitar demostración o cotización">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Enviar}" Margin="0,0,8,0" />
                  <TextBlock Text="Solicitar demostración o cotización" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding VerFormulario, Converter={StaticResource Visible}}">
              <Button Content="Volver a los planes" Style="{StaticResource BotonSecundario}" Margin="0,0,12,0" Command="{Binding VolverAPlanesCommand}" />
              <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding EnviarCommand}" AutomationProperties.Name="Enviar solicitud">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Enviar}" Margin="0,0,8,0" />
                  <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Enviar solicitud" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EnviarCommand.IsRunning}" Value="True">
                            <Setter Property="Text" Value="Enviando…" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Content="Entendido" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsDefault="True"
                    Command="{Binding CerrarCommand}" Visibility="{Binding Enviada, Converter={StaticResource Visible}}" />
          </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="24,8,24,20">
            <!-- Aviso de error (MSG-011, 429…) -->
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                    Margin="0,0,0,16" Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" AutomationProperties.LiveSetting="Assertive">
              <DockPanel>
                <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                                Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                <StackPanel>
                  <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Text="{Binding Aviso.Mensaje}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
            </Border>

            <!-- Paso 1: comparativa de planes -->
            <StackPanel Visibility="{Binding VerPlanes, Converter={StaticResource Visible}}">
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="Todos los planes incluyen todas las funciones; solo cambia la capacidad. La aplicación se descarga gratis y se usa con la cuenta que entrega SITBIO al activar el servicio." />
              <ItemsControl ItemsSource="{Binding Planes}" Focusable="False" Margin="-6,16,-6,14" AutomationProperties.Name="Planes del servicio">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PlanVisible}">
                    <Grid Margin="6,0">
                    <Border x:Name="Tarjeta" Padding="16" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            AutomationProperties.Name="{Binding Nombre}">
                      <DockPanel>
                        <Button x:Name="Elegir" DockPanel.Dock="Bottom" Margin="0,14,0,0" Style="{StaticResource BotonSecundario}" Padding="10,6"
                                Content="{Binding TextoBoton}" AutomationProperties.Name="{Binding TextoBoton}"
                                Command="{Binding DataContext.ElegirPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Nombre}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                          <TextBlock Text="{Binding Dirigido}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                          <TextBlock Margin="0,12,0,10" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap">
                            <Run Text="{Binding Valor, Mode=OneWay}" FontSize="18" FontWeight="Bold" /><Run Text=" " /><Run
                                 Text="{Binding Periodo, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Brush.Text3}" />
                          </TextBlock>
                          <ItemsControl ItemsSource="{Binding Incluye}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                  <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                                                  Width="15" Height="15" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Top" Margin="0,1,8,0" />
                                  <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}" />
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <!-- Franja superior de la tarjeta elegida, sin mover su contenido -->
                    <Border x:Name="Franja" Height="4" VerticalAlignment="Top" CornerRadius="10,10,0,0" Background="{DynamicResource Brush.Primary}"
                            Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Seleccionado}" Value="True">
                        <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                        <Setter TargetName="Franja" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Elegir" Property="Background" Value="{DynamicResource Brush.Primary}" />
                        <Setter TargetName="Elegir" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                        <Setter TargetName="Elegir" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                         Text="Valores de referencia mensuales. Los equipos dados de baja no consumen capacidad y las cuentas temporales del ente regulador no se cuentan." />
            </StackPanel>

            <!-- Paso 2: formulario de la solicitud -->
            <Grid Visibility="{Binding VerFormulario, Converter={StaticResource Visible}}" Width="720">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Institución" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorInstitucion}">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Institucion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Institución" />
                </Border>
                <TextBlock Text="{Binding ErrorInstitucion}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorInstitucion, Converter={StaticResource TextoVisible}}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="NIT" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorNit}">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="NIT" />
                </Border>
                <TextBlock Text="{Binding ErrorNit}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorNit, Converter={StaticResource TextoVisible}}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Persona de contacto" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorContacto}">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Persona de contacto" />
                </Border>
                <TextBlock Text="{Binding ErrorContacto}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorContacto, Converter={StaticResource TextoVisible}}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorCorreo}">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Correo" />
                </Border>
                <TextBlock Text="{Binding ErrorCorreo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorCorreo, Converter={StaticResource TextoVisible}}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6">
                  <Run Text="Teléfono" /><Run Text=" (opcional)" FontWeight="Normal" Foreground="{DynamicResource Brush.Text3}" />
                </TextBlock>
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorTelefono}">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Teléfono (opcional)" />
                </Border>
                <TextBlock Text="{Binding ErrorTelefono}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorTelefono, Converter={StaticResource TextoVisible}}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Plan de interés" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding OpcionesPlan}" SelectedItem="{Binding Plan}" AutomationProperties.Name="Plan de interés" />
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0">
                <TextBlock Text="Tipo de solicitud" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:SolicitudServicioViewModel.OpcionesTipo}"
                          SelectedItem="{Binding TipoElegido}" AutomationProperties.Name="Tipo de solicitud" />
              </StackPanel>

              <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6">
                  <Run Text="Mensaje" /><Run Text=" (opcional)" FontWeight="Normal" Foreground="{DynamicResource Brush.Text3}" />
                </TextBlock>
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorMensaje}" Padding="13,8">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Mensaje, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="64" MaxLength="1000" AutomationProperties.Name="Mensaje (opcional)" />
                </Border>
                <TextBlock Text="{Binding ErrorMensaje}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorMensaje, Converter={StaticResource TextoVisible}}" />
                <TextBlock Text="Cuéntanos cuántos equipos y usuarios tienes, aproximadamente." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
              </StackPanel>

              <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                         Text="Usamos estos datos solo para responder tu solicitud (Ley 1581 de 2012)." />
            </Grid>

            <!-- Paso 3: MSG-021, solicitud recibida con su código -->
            <StackPanel Visibility="{Binding Enviada, Converter={StaticResource Visible}}" Width="720">
              <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                      Margin="0,8,0,18" AutomationProperties.LiveSetting="Polite">
                <DockPanel>
                  <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.CheckCirculo}"
                                  Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                  <StackPanel>
                    <TextBlock Text="Solicitud de servicio enviada" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}" Margin="0,2,0,0">
                      <Run Text="Recibimos tu solicitud" /> <Run Text="{Binding CodigoEnviado, Mode=OneWay}" FontWeight="SemiBold" /><Run
                           Text=". El equipo de SITBIO te contactará en máximo 2 días hábiles en" /> <Run Text="{Binding CorreoEnviado, Mode=OneWay}" /><Run Text="." />
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,12,14">
                  <TextBlock Text="Institución" Style="{StaticResource Clave}" />
                  <TextBlock Text="{Binding Institucion}" Style="{StaticResource Valor}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="Tipo" Style="{StaticResource Clave}" />
                  <TextBlock Text="{Binding TipoElegido}" Style="{StaticResource Valor}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="Plan de interés" Style="{StaticResource Clave}" />
                  <TextBlock Text="{Binding PlanResumen}" Style="{StaticResource Valor}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Código" Style="{StaticResource Clave}" />
                  <TextBlock Text="{Binding CodigoEnviado}" Style="{StaticResource Valor}" />
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
