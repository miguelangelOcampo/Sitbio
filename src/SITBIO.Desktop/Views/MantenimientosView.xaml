<!-- UI-015 Mantenimientos (HU-019; FLU-008): pestañas «Planes preventivos» y «Calibraciones» (UI-017, HU-022).
     Planes: página + panel lateral, de la próxima fecha más cercana a la más lejana y, para el Ingeniero
     Biomédico (AC-02), el formulario del plan. Calibraciones: página + formulario (DataContext = Calibraciones);
     el Técnico (AC-03) registra y corrige, el Ingeniero aprueba. Los demás roles solo consultan. El estado, el
     vencimiento y la vigencia son punto + texto, no solo color (ACC-001). -->
<UserControl x:Class="Sitbio.Desktop.Views.MantenimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:svc="clr-namespace:Sitbio.Desktop.Services"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:ProxyDatos x:Key="Proxy" Datos="{Binding}" />

    <Style x:Key="CampoValidado" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Fila elegible de la búsqueda de equipos: toda la fila es el botón. -->
    <Style x:Key="FilaEquipo" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" Background="Transparent" Padding="8,10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="40,24,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Confirmación -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding Exito, Converter={StaticResource TextoVisible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarExitoCommand}" Margin="16,0,0,0" />
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                            Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <TextBlock Text="{Binding Exito}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NuevoPlanCommand}" VerticalAlignment="Bottom"
                  Visibility="{Binding PuedeCrearPlan, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Agregar}" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock Text="Nuevo plan" />
            </StackPanel>
          </Button>
          <StackPanel>
            <TextBlock Text="GESTIÓN BIOMÉDICA" Style="{StaticResource Overline}" />
            <TextBlock Text="Mantenimientos" Style="{StaticResource PageTitle}" Margin="0,4,0,6" />
            <TextBlock Text="Programa el mantenimiento preventivo de cada equipo y controla la vigencia de sus calibraciones. Cuando llega la fecha, la orden preventiva se genera sola y se asigna al técnico con menos órdenes abiertas."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <!-- Pestañas -->
        <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,0,1" Margin="0,20,0,20">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasMantenimiento" Content="Planes preventivos"
                         IsChecked="{Binding EnPlanes, Mode=OneWay}" Command="{Binding MostrarPlanesCommand}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasMantenimiento" Content="Calibraciones"
                         IsChecked="{Binding EnCalibraciones, Mode=OneWay}" Command="{Binding MostrarCalibracionesCommand}" />
          </StackPanel>
        </Border>

        <!-- Calibraciones (UI-017, HU-022) -->
        <StackPanel DataContext="{Binding Calibraciones}"
                    Visibility="{Binding DataContext.EnCalibraciones, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
          <!-- Aviso de error -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                  Margin="0,0,0,14" AutomationProperties.LiveSetting="Assertive"
                  Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                        Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
                <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
              </StackPanel>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                  <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Confirmación -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                  Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"
                  Visibility="{Binding Exito, Converter={StaticResource TextoVisible}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarExitoCommand}" Margin="16,0,0,0" />
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                              Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
              <TextBlock Text="{Binding Exito}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NuevaCalibracionCommand}" VerticalAlignment="Center"
                    Visibility="{Binding PuedeRegistrar, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Agregar}" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="Registrar calibración" />
              </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Solo se calibran los equipos que lo requieren (RN-010). El Técnico registra la calibración y el Ingeniero Biomédico la aprueba."
                         Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="Tu rol consulta las calibraciones." Style="{StaticResource Muted}" Margin="0,4,0,0"
                         Visibility="{Binding SoloConsulta, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DockPanel>

          <!-- Formulario de registro o corrección (AC-03) -->
          <Border Style="{StaticResource Section}" Margin="0,0,0,18" Visibility="{Binding FormularioAbierto, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="Formulario de la calibración">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CerrarFormularioCommand}"
                        AutomationProperties.Name="Cerrar el formulario de la calibración" VerticalAlignment="Top">
                  <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
                </Button>
                <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
              </DockPanel>

              <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                      Margin="0,14,0,0" AutomationProperties.LiveSetting="Assertive"
                      Visibility="{Binding AvisoFormulario, Converter={StaticResource NuloVisible}}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AvisoFormulario.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                    <TextBlock Text="{Binding AvisoFormulario.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding AvisoFormulario.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Border>

              <!-- Equipo (CMP-UI-003): solo al registrar y solo equipos que requieren calibración -->
              <StackPanel Visibility="{Binding EsNueva, Converter={StaticResource Visible}}" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Equipo *" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorEquipo}" Width="520">
                  <TextBox Style="{StaticResource FieldInput}" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                           AutomationProperties.Name="Buscar equipo que requiere calibración por placa o serie" />
                </Border>
                <TextBlock Text="{Binding ErrorEquipo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorEquipo, Converter={StaticResource TextoVisible}}" />
                <TextBlock Text="Escribe al menos 2 caracteres de la placa o la serie. Solo aparecen los equipos que requieren calibración."
                           Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding TextoEquipo}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}" />
                <TextBlock Text="Buscando…" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                           Visibility="{Binding Buscando, Converter={StaticResource Visible}}" />
                <TextBlock Text="No hay equipos activos que requieran calibración con esa placa o serie." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                           Visibility="{Binding SinCoincidencias, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Coincidencias}" Margin="0,6,0,0" Focusable="False"
                              Visibility="{Binding HayCoincidencias, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:Equipo}">
                      <Border Style="{StaticResource ListRow}" Padding="0">
                        <Button Style="{StaticResource FilaEquipo}" Command="{Binding DataContext.ElegirEquipoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding PlacaInventario, StringFormat='Elegir equipo {0}'}">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                              <Run Text="{Binding PlacaInventario, Mode=OneWay}" />
                              <Run Text="·" Foreground="{DynamicResource Brush.Text3}" />
                              <Run Text="{Binding TipoEquipo, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource Brush.Text2}" FontSize="13">
                              <Run Text="Serie" />
                              <Run Text="{Binding NumeroSerie, Mode=OneWay}" />
                              <Run Text="·" />
                              <Run Text="{Binding Ubicacion, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                        </Button>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <WrapPanel Margin="0,4,0,0">
                <!-- Fecha -->
                <StackPanel Margin="0,14,24,0">
                  <TextBlock Text="Fecha de la calibración *" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorFecha}" Width="180" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding FechaCalibracion, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Fecha de la calibración, dd/mm/aaaa" />
                  </Border>
                  <TextBlock Text="{Binding ErrorFecha}" Style="{StaticResource FieldError}" MaxWidth="240" TextWrapping="Wrap"
                             Visibility="{Binding ErrorFecha, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
                <!-- Resultado -->
                <StackPanel Margin="0,14,24,0">
                  <TextBlock Text="Resultado *" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <ComboBox Style="{StaticResource FieldCombo}" Width="200" ItemsSource="{x:Static vm:CalibracionesViewModel.OpcionesResultado}"
                            SelectedItem="{Binding Resultado}" DisplayMemberPath="Texto" AutomationProperties.Name="Resultado de la calibración" />
                </StackPanel>
                <!-- Vencimiento -->
                <StackPanel Margin="0,14,0,0">
                  <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorVencimiento}" Width="180" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding Vencimiento, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Fecha de vencimiento de la calibración, dd/mm/aaaa" />
                  </Border>
                  <TextBlock Text="Vacío: fecha + periodicidad del equipo." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding ErrorVencimiento}" Style="{StaticResource FieldError}" MaxWidth="240" TextWrapping="Wrap"
                             Visibility="{Binding ErrorVencimiento, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding VencimientoCalculado}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,8,0,0"
                         AutomationProperties.LiveSetting="Polite" Visibility="{Binding VencimientoCalculado, Converter={StaticResource TextoVisible}}" />

              <!-- Patrón de referencia -->
              <TextBlock Text="Patrón de referencia *" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
              <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorPatron}" MaxWidth="520" HorizontalAlignment="Stretch">
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Patron, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Patrón de referencia usado en la calibración" />
              </Border>
              <TextBlock Text="{Binding ErrorPatron}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorPatron, Converter={StaticResource TextoVisible}}" />

              <!-- Certificado -->
              <TextBlock Text="Número de certificado" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
              <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorCertificado}" Width="280" HorizontalAlignment="Left">
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Certificado, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Número del certificado de calibración" />
              </Border>
              <TextBlock Text="{Binding ErrorCertificado}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorCertificado, Converter={StaticResource TextoVisible}}" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <TextBlock Text="Guardando…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding Guardando, Converter={StaticResource Visible}}" />
                <Button Content="Cancelar" Style="{StaticResource LinkButton}" Command="{Binding CerrarFormularioCommand}" Margin="0,0,20,0" />
                <Button Content="Guardar calibración" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <WrapPanel Margin="0,0,0,14" Visibility="{Binding HayFiltroEquipo, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TextoFiltroEquipo}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                <Button Content="Ver todas" Style="{StaticResource LinkButton}" Command="{Binding QuitarFiltroEquipoCommand}" Margin="14,0,0,0" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Confirmar «Aprobar» (no se deshace) -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                  Margin="0,0,0,14" AutomationProperties.LiveSetting="Assertive"
                  Visibility="{Binding ConfirmandoAprobar, Converter={StaticResource NuloVisible}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="Cancelar" Style="{StaticResource LinkButton}" Command="{Binding CancelarAprobarCommand}" Margin="0,0,16,0" />
                <Button Content="Aprobar calibración" Style="{StaticResource PrimaryButton}" Command="{Binding AprobarCommand}"
                        CommandParameter="{Binding ConfirmandoAprobar}" />
              </StackPanel>
              <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" VerticalAlignment="Center">
                <Run Text="¿Aprobar la calibración de" /><Run Text="{Binding ConfirmandoAprobar.Calibracion.PlacaInventario, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="? Ya no se podrá corregir." />
              </TextBlock>
            </DockPanel>
          </Border>

          <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58" AutomationProperties.Name="Calibraciones"
                    ScrollViewer.CanContentScroll="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="EQUIPO" Width="1.4*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                    <StackPanel>
                      <TextBlock Text="{Binding Equipo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                      <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="CALIBRACIÓN" Width="1.6*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                    <StackPanel>
                      <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Patron}">
                        <Run Text="{Binding Fecha, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Patron, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Resultado, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Certificado, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="VENCE" Width="1.1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                    <StackPanel>
                      <TextBlock Text="{Binding Vence}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource PuntoEstado}" />
                        <TextBlock Text="{Binding Vigencia}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="REGISTRO" Width="1.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                    <StackPanel>
                      <TextBlock Text="{Binding Aprobacion}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Registro}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="0.8*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaCalibracion}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Corregir" Style="{StaticResource LinkButton}"
                              Visibility="{Binding PuedeCorregir, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.AbrirCorreccionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Calibracion.PlacaInventario, StringFormat='Corregir la calibración de {0}'}" />
                      <Button Content="Aprobar" Style="{StaticResource LinkButton}"
                              Visibility="{Binding PuedeAprobar, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.AprobarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Calibracion.PlacaInventario, StringFormat='Aprobar la calibración de {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Consultando las calibraciones…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                     Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
          <StackPanel Margin="0,24,0,0" Visibility="{Binding SinCalibraciones, Converter={StaticResource Visible}}">
            <TextBlock Text="No hay calibraciones registradas." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="Las calibraciones de los equipos que la requieren aparecerán aquí con su vencimiento." Style="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>

          <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Actualizar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,20,0" />
              <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                      AutomationProperties.Name="Página anterior de calibraciones" />
              <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                      AutomationProperties.Name="Página siguiente de calibraciones" />
            </StackPanel>
            <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>

        <!-- Planes preventivos (UI-015) -->
        <StackPanel Visibility="{Binding EnPlanes, Converter={StaticResource Visible}}">
          <TextBlock Text="Solo el Ingeniero Biomédico crea y modifica los planes; tu rol los consulta." Style="{StaticResource Muted}"
                     Margin="0,0,0,14" Visibility="{Binding SoloConsulta, Converter={StaticResource Visible}}" />

          <WrapPanel Margin="0,0,0,14">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Estado" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
              <ComboBox Style="{StaticResource FieldCombo}" Width="200" ItemsSource="{x:Static vm:MantenimientosViewModel.OpcionesEstado}"
                        SelectedItem="{Binding FiltroEstado}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por estado del plan" />
            </StackPanel>
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.PrimarySoft}" BorderBrush="{DynamicResource Brush.Primary}"
                    VerticalAlignment="Bottom" Padding="12,7" Visibility="{Binding HayFiltroEquipo, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TextoFiltroEquipo}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                <Button Content="Ver todos" Style="{StaticResource LinkButton}" Command="{Binding QuitarFiltroEquipoCommand}" Margin="14,0,0,0" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Confirmar «Finalizar» (no se deshace) -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                  Margin="0,0,0,14" AutomationProperties.LiveSetting="Assertive"
                  Visibility="{Binding ConfirmandoFinalizar, Converter={StaticResource NuloVisible}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="Cancelar" Style="{StaticResource LinkButton}" Command="{Binding CancelarFinalizarCommand}" Margin="0,0,16,0" />
                <Button Content="Finalizar plan" Style="{StaticResource PrimaryButton}" Command="{Binding CambiarEstadoCommand}"
                        CommandParameter="{Binding ConfirmandoFinalizar.Finalizar}" />
              </StackPanel>
              <TextBlock Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" VerticalAlignment="Center">
                <Run Text="¿Finalizar el plan de" /><Run Text="{Binding ConfirmandoFinalizar.Plan.PlacaInventario, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="? Ya no generará órdenes ni alertas y no se podrá modificar." />
              </TextBlock>
            </DockPanel>
          </Border>

          <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58" AutomationProperties.Name="Planes preventivos"
                    ScrollViewer.CanContentScroll="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="EQUIPO" Width="1.6*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <StackPanel>
                      <TextBlock Text="{Binding Equipo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                      <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="PLAN" Width="1.6*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <StackPanel>
                      <TextBlock Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Descripcion}" />
                      <TextBlock Text="{Binding Periodicidad}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ÚLTIMO" Width="0.9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <TextBlock Text="{Binding Ultimo}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="PRÓXIMO" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <StackPanel>
                      <TextBlock Text="{Binding Proximo}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Vencimiento}" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                                 Visibility="{Binding Vencimiento, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ESTADO" Width="0.9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoEstado}" />
                      <TextBlock Text="{Binding Estado}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="1.5*"
                                      Visibility="{Binding Datos.PuedeGestionar, Source={StaticResource Proxy}, Converter={StaticResource Visible}}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaPlan}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding Editable, Converter={StaticResource Visible}}">
                      <Button Content="Editar" Style="{StaticResource LinkButton}" Margin="0,0,14,0"
                              Command="{Binding DataContext.AbrirEdicionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Plan.PlacaInventario, StringFormat='Editar el plan de {0}'}" />
                      <Button Content="Suspender" Style="{StaticResource LinkButton}" Margin="0,0,14,0"
                              Visibility="{Binding PuedeSuspender, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Suspender}"
                              AutomationProperties.Name="{Binding Plan.PlacaInventario, StringFormat='Suspender el plan de {0}'}" />
                      <Button Content="Reactivar" Style="{StaticResource LinkButton}" Margin="0,0,14,0"
                              Visibility="{Binding PuedeReactivar, Converter={StaticResource Visible}}"
                              Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Reactivar}"
                              AutomationProperties.Name="{Binding Plan.PlacaInventario, StringFormat='Reactivar el plan de {0}'}" />
                      <Button Content="Finalizar" Style="{StaticResource LinkButton}"
                              Command="{Binding DataContext.CambiarEstadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Finalizar}"
                              AutomationProperties.Name="{Binding Plan.PlacaInventario, StringFormat='Finalizar el plan de {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Consultando los planes…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                     Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
          <StackPanel Margin="0,24,0,0" Visibility="{Binding SinPlanes, Converter={StaticResource Visible}}">
            <TextBlock Text="No hay planes con este filtro." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="Los planes que se definan al registrar un equipo o con «Nuevo plan» aparecerán aquí." Style="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>

          <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Actualizar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,20,0" />
              <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                      AutomationProperties.Name="Página anterior" />
              <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                      AutomationProperties.Name="Página siguiente" />
            </StackPanel>
            <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Panel del plan (solo AC-02) -->
    <Border Grid.Column="1" Width="400" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
            Visibility="{Binding PanelAbierto, Converter={StaticResource Visible}}" AutomationProperties.Name="Panel del plan preventivo">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,14">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Guardando…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Visibility="{Binding Guardando, Converter={StaticResource Visible}}" />
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" Command="{Binding CerrarPanelCommand}" Margin="0,0,20,0" />
            <Button Content="Guardar plan" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}" IsDefault="True" />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="24">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CerrarPanelCommand}"
                      AutomationProperties.Name="Cerrar el panel del plan" VerticalAlignment="Top">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
              </Button>
              <TextBlock Text="PLAN PREVENTIVO" Style="{StaticResource Overline}" />
            </DockPanel>
            <TextBlock Text="{Binding TituloPanel}" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,4,0,0" TextWrapping="Wrap" />

            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                    Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding AvisoPanel, Converter={StaticResource NuloVisible}}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding AvisoPanel.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                  <TextBlock Text="{Binding AvisoPanel.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding AvisoPanel.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <!-- Equipo (CMP-UI-003): solo al crear; el plan queda asociado a él (CA-HU-019-01) -->
            <StackPanel Visibility="{Binding EsNuevo, Converter={StaticResource Visible}}">
              <TextBlock Text="Equipo *" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
              <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorEquipo}">
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         AutomationProperties.Name="Buscar equipo por placa o serie" />
              </Border>
              <TextBlock Text="{Binding ErrorEquipo}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorEquipo, Converter={StaticResource TextoVisible}}" />
              <TextBlock Text="Escribe al menos 2 caracteres de la placa o la serie." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
              <TextBlock Text="{Binding TextoEquipo}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                         Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}" />
              <TextBlock Text="Buscando…" Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                         Visibility="{Binding Buscando, Converter={StaticResource Visible}}" />
              <TextBlock Text="No hay equipos activos con esa placa o serie." Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                         Visibility="{Binding SinCoincidencias, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding Coincidencias}" Margin="0,6,0,0" Focusable="False"
                            Visibility="{Binding HayCoincidencias, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type svc:Equipo}">
                    <Border Style="{StaticResource ListRow}" Padding="0">
                      <Button Style="{StaticResource FilaEquipo}" Command="{Binding DataContext.ElegirEquipoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding PlacaInventario, StringFormat='Elegir equipo {0}'}">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding PlacaInventario, Mode=OneWay}" />
                            <Run Text="·" Foreground="{DynamicResource Brush.Text3}" />
                            <Run Text="{Binding TipoEquipo, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Foreground="{DynamicResource Brush.Text2}" FontSize="13">
                            <Run Text="Serie" />
                            <Run Text="{Binding NumeroSerie, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding Ubicacion, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Descripción -->
            <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorDescripcion}">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Descripción del plan" />
            </Border>
            <TextBlock Text="Opcional. Sin descripción se usa «Mantenimiento preventivo»." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorDescripcion}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorDescripcion, Converter={StaticResource TextoVisible}}" />

            <!-- Periodicidad -->
            <TextBlock Text="Periodicidad (días) *" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorPeriodicidad}" Width="140" HorizontalAlignment="Left">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding Periodicidad, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Periodicidad del preventivo en días" />
            </Border>
            <TextBlock Text="{Binding ErrorPeriodicidad}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorPeriodicidad, Converter={StaticResource TextoVisible}}" />

            <!-- Último preventivo -->
            <TextBlock Text="Último preventivo" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorUltima}" Width="180" HorizontalAlignment="Left">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding UltimaEjecucion, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Fecha del último preventivo, dd/mm/aaaa" />
            </Border>
            <TextBlock Text="dd/mm/aaaa. Opcional si indicas el próximo." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorUltima}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorUltima, Converter={StaticResource TextoVisible}}" />

            <!-- Próximo preventivo -->
            <TextBlock Text="Próximo preventivo" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorProxima}" Width="180" HorizontalAlignment="Left">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding ProximaFecha, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Fecha del próximo preventivo, dd/mm/aaaa" />
            </Border>
            <TextBlock Text="dd/mm/aaaa. Déjalo vacío para calcularlo como último + periodicidad." Style="{StaticResource Muted}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorProxima}" Style="{StaticResource FieldError}" Visibility="{Binding ErrorProxima, Converter={StaticResource TextoVisible}}" />
            <TextBlock Text="{Binding ProximoCalculado}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,10,0,0"
                       AutomationProperties.LiveSetting="Polite" Visibility="{Binding ProximoCalculado, Converter={StaticResource TextoVisible}}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
