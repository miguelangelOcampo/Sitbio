<!-- UI-024 Bitácora de auditoría (HU-010, AC-01 y AC-07; prototipo vigente). Siempre solo lectura
     (DOC-05 §9): sin acciones por fila. Diseño clínico editorial: indicadores en franja, filtros,
     tabla abierta y acción como punto + texto. -->
<UserControl x:Class="Sitbio.Desktop.Views.BitacoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <!-- Campo de fecha: caja con texto de ayuda mientras está vacía; roja si hay error de fechas -->
    <Style x:Key="CampoFecha" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Setter Property="MinHeight" Value="42" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ErrorFechas, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AyudaFecha" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="15,0,0,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <!-- Encabezado -->
      <TextBlock Text="ADMINISTRACIÓN" Style="{StaticResource Overline}" />
      <TextBlock Text="Bitácora de auditoría" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                 Text="Registro inalterable de las acciones realizadas en SITBIO: quién, qué, cuándo y desde dónde. Solo muestra eventos de tu institución." />

      <!-- Aviso de error -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
              Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                          Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
            <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0" />
            <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Indicadores -->
      <Border Style="{StaticResource KpiStrip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource KpiItem}" BorderThickness="0" Padding="0,14,20,14">
            <StackPanel>
              <TextBlock Text="EVENTOS" Style="{StaticResource Overline}" />
              <TextBlock Text="{Binding Total, StringFormat=N0}" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Con los filtros actuales" Style="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource KpiItem}">
            <StackPanel>
              <TextBlock Text="ACCESOS DENEGADOS" Style="{StaticResource Overline}" />
              <TextBlock Text="{Binding Denegados, StringFormat=N0}" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Respuestas 403 (RNF-003)" Style="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource KpiItem}">
            <StackPanel>
              <TextBlock Text="INICIOS FALLIDOS" Style="{StaticResource Overline}" />
              <TextBlock Text="{Binding Fallidos, StringFormat=N0}" Style="{StaticResource KpiValue}" />
              <TextBlock Text="Credenciales o cuenta bloqueada" Style="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource KpiItem}">
            <StackPanel>
              <TextBlock Text="INTEGRIDAD" Style="{StaticResource Overline}" />
              <TextBlock Text="Solo inserción" Style="{StaticResource KpiValue}" FontSize="22" Margin="0,8,0,4" />
              <TextBlock Text="Ningún evento se edita ni se borra" Style="{StaticResource Muted}" FontSize="13" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Filtros -->
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding OpcionesUsuario}"
                  SelectedItem="{Binding FiltroUsuario}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por usuario" />
        <ComboBox Grid.Column="2" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:BitacoraViewModel.OpcionesAccion}"
                  SelectedItem="{Binding FiltroAccion}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por acción" />

        <Border Grid.Column="4" Style="{StaticResource CampoFecha}">
          <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Desde}" AutomationProperties.Name="Desde (dd/mm/aaaa)" />
        </Border>
        <TextBlock Grid.Column="4" Text="Desde dd/mm/aaaa">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource AyudaFecha}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Desde.Length}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Border Grid.Column="6" Style="{StaticResource CampoFecha}">
          <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Hasta}" AutomationProperties.Name="Hasta (dd/mm/aaaa)" />
        </Border>
        <TextBlock Grid.Column="6" Text="Hasta dd/mm/aaaa">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource AyudaFecha}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Hasta.Length}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Button Grid.Column="7" Content="Limpiar" Style="{StaticResource LinkButton}" Command="{Binding LimpiarCommand}"
                VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" />
      </Grid>
      <TextBlock Text="{Binding ErrorFechas}" Style="{StaticResource FieldError}"
                 Visibility="{Binding ErrorFechas, Converter={StaticResource TextoVisible}}" />

      <!-- Tabla abierta, solo lectura -->
      <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58" Margin="0,8,0,0"
                AutomationProperties.Name="Eventos de la bitácora" ScrollViewer.CanContentScroll="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="FECHA Y HORA" Width="1.1*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <StackPanel>
                  <TextBlock Text="{Binding Fecha}" />
                  <TextBlock Text="{Binding Hora}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="USUARIO" Width="1.4*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <TextBlock Text="{Binding Usuario}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Usuario}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ACCIÓN" Width="1.9*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Punto" Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Info}" />
                    <TextBlock Text="{Binding Accion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Accion}" />
                  </StackPanel>
                  <TextBlock Text="{Binding CodigoAccion}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.Text3}" Margin="16,0,0,0" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoAccion.Exito}">
                    <Setter TargetName="Punto" Property="Fill" Value="{DynamicResource Brush.Success}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoAccion.Critico}">
                    <Setter TargetName="Punto" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoAccion.Neutro}">
                    <Setter TargetName="Punto" Property="Fill" Value="{DynamicResource Brush.Text3}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="ENTIDAD" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <TextBlock Text="{Binding Entidad}" FontFamily="Consolas" FontSize="13" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="DETALLE" Width="2.2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <TextBlock Text="{Binding Detalle}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detalle}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="IP" Width="0.8*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:FilaBitacora}">
                <TextBlock Text="{Binding Ip}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Brush.Text2}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Consultando la bitácora…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                 Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
      <StackPanel Margin="0,24,0,0" Visibility="{Binding SinEventos, Converter={StaticResource Visible}}">
        <TextBlock Text="No hay eventos con esos filtros" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
        <TextBlock Text="Cambia el usuario, la acción o las fechas, o usa «Limpiar» para ver todo." Style="{StaticResource Muted}" Margin="0,4,0,0" />
      </StackPanel>

      <!-- Pie: resumen y paginación -->
      <DockPanel Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                  AutomationProperties.Name="Página anterior" />
          <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                  AutomationProperties.Name="Página siguiente" />
        </StackPanel>
        <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
