<!-- UI-005 Equipos biomédicos y UI-006 Hoja de vida (HU-002; prototipo v0.21, Equipos.tsx). La hoja de
     vida se abre encima de la lista y, al volver por las migas, la lista conserva filtros y página
     (NAV-006). Diseño clínico editorial: tabla abierta, estado como punto + texto, sin tarjetas. -->
<UserControl x:Class="Sitbio.Desktop.Views.EquiposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <!-- Punto de estado según el tono -->
    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Pares etiqueta–valor de la hoja de vida -->
    <DataTemplate x:Key="PlantillaDato" DataType="{x:Type vm:Dato}">
      <StackPanel Margin="0,0,24,18">
        <TextBlock Text="{Binding Etiqueta}" Style="{StaticResource Muted}" FontSize="13" />
        <TextBlock x:Name="Valor" Text="{Binding Valor}" Foreground="{DynamicResource Brush.Text}" FontSize="15"
                   TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Codigo}" Value="True">
          <Setter TargetName="Valor" Property="FontFamily" Value="Consolas" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- UI-006 Hoja de vida -->
    <DataTemplate DataType="{x:Type vm:DetalleEquipoViewModel}">
      <StackPanel>
        <!-- Migas de pan -->
        <StackPanel Orientation="Horizontal">
          <Button Content="Equipos biomédicos" Style="{StaticResource LinkButton}" Command="{Binding VolverCommand}"
                  AutomationProperties.Name="Volver a Equipos biomédicos" />
          <TextBlock Text=" / " Style="{StaticResource Muted}" />
          <TextBlock Text="{Binding Placa}" FontFamily="Consolas" Foreground="{DynamicResource Brush.Text2}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Encabezado: el recuadro del ícono es el lugar de la miniatura de la fotografía (HU-015, RF-031) -->
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Brush.PrimarySoft}" VerticalAlignment="Top"
                  AutomationProperties.Name="Ícono del tipo de equipo">
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Equipo}" Width="28" Height="28"
                            Foreground="{DynamicResource Brush.Primary}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Titulo}" Style="{StaticResource PageTitle}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,4,0,0"
                          Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}">
                <Ellipse Style="{StaticResource PuntoEstado}" />
                <TextBlock Text="{Binding Estado}" Foreground="{DynamicResource Brush.Text}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
              <TextBlock Text="  ·  " Style="{StaticResource Muted}" Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}" />
              <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Muted}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <TextBlock Text="Abriendo la hoja de vida…" Style="{StaticResource Muted}" Margin="0,18,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

        <!-- Error al consultar -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,18,0,0" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0" />
              <Button Content="Volver" Style="{StaticResource LinkButton}" Command="{Binding VolverCommand}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" />
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Equipo dado de baja (RF-014) -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Info}"
                Margin="0,18,0,0" Visibility="{Binding AvisoBaja, Converter={StaticResource NuloVisible}}">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding AvisoBaja.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
              <TextBlock Text="{Binding AvisoBaja.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}" />
            </DockPanel>
            <TextBlock Text="{Binding AvisoBaja.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <!-- RN-010: autorización vencida, por vencer o faltante (aviso, no bloqueo) -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                Margin="0,18,0,0" Visibility="{Binding AvisoRegulatorio, Converter={StaticResource NuloVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.WarningText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AvisoRegulatorio.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding AvisoRegulatorio.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
              </DockPanel>
              <TextBlock Text="{Binding AvisoRegulatorio.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Visibility="{Binding HayEquipo, Converter={StaticResource Visible}}">
          <!-- Pestañas -->
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Resumen" IsChecked="{Binding EnResumen}" />
            <RadioButton Style="{StaticResource Pestana}" GroupName="PestanasEquipo" Content="Información técnica" IsChecked="{Binding EnTecnica}" />
          </StackPanel>
          <Border Height="1" Background="{DynamicResource Brush.Border}" />

          <!-- Resumen -->
          <StackPanel Visibility="{Binding EnResumen, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <Border Style="{StaticResource KpiStrip}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiItem}" BorderThickness="0" Padding="0,14,20,14">
                  <StackPanel>
                    <TextBlock Text="PRÓXIMO MANTENIMIENTO" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding ProximoMantenimiento}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                          <Setter Property="FontSize" Value="24" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding MantenimientoVencido}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetalleMantenimiento}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiItem}">
                  <StackPanel>
                    <TextBlock Text="CALIBRACIÓN" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Calibracion}" Style="{StaticResource KpiValue}" FontSize="24" />
                    <TextBlock Text="{Binding DetalleCalibracion}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiItem}">
                  <StackPanel>
                    <TextBlock Text="AUTORIZACIÓN INVIMA" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Autorizacion}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                          <Setter Property="FontSize" Value="24" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AutorizacionEnAlerta}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetalleAutorizacion}" Style="{StaticResource Muted}" FontSize="13" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Style="{StaticResource Section}" Margin="0,28,0,0">
              <StackPanel>
                <TextBlock Text="Datos del activo" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding DatosActivo}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Información técnica -->
          <StackPanel Visibility="{Binding EnTecnica, Converter={StaticResource Visible}}" Margin="0,22,0,0">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Información técnica" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding InformacionTecnica}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <TextBlock DockPanel.Dock="Right" Text="RF-030 · RN-010" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                  <TextBlock Text="Información regulatoria" Style="{StaticResource SectionTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding InformacionRegulatoria}" ItemTemplate="{StaticResource PlantillaDato}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <ContentControl Content="{Binding Detalle}" Focusable="False" IsTabStop="False"
                      Visibility="{Binding Detalle, Converter={StaticResource NuloVisible}}" />

      <!-- UI-005 Lista -->
      <StackPanel Visibility="{Binding EnLista, Converter={StaticResource Visible}}">
        <TextBlock Text="GESTIÓN BIOMÉDICA" Style="{StaticResource Overline}" />
        <TextBlock Text="Equipos biomédicos" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                   Text="Inventario de la institución con estado operativo, ubicación, clase de riesgo y próximo mantenimiento de cada activo." />

        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Filtros -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesBuscarPor}"
                    SelectedItem="{Binding BuscarPor}" DisplayMemberPath="Texto" AutomationProperties.Name="Buscar por" />
          <Border Grid.Column="2" Style="{StaticResource FieldBox}" MinHeight="42">
            <DockPanel>
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Buscar}" Width="16" Height="16" Margin="0,0,10,0" />
              <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                       AutomationProperties.Name="{Binding TextoBusqueda}" />
            </DockPanel>
          </Border>
          <!-- Texto de ayuda mientras la búsqueda está vacía -->
          <TextBlock Grid.Column="2" Text="{Binding TextoBusqueda}" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Busqueda.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ComboBox Grid.Column="4" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesEstado}"
                    SelectedItem="{Binding FiltroEstado}" DisplayMemberPath="Texto" AutomationProperties.Name="Estado operativo" />
          <ComboBox Grid.Column="6" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:EquiposViewModel.OpcionesRiesgo}"
                    SelectedItem="{Binding FiltroRiesgo}" DisplayMemberPath="Texto" AutomationProperties.Name="Riesgo y calibración" />
        </Grid>

        <DockPanel Margin="0,18,0,0">
          <Button DockPanel.Dock="Right" Content="Limpiar filtros" Style="{StaticResource LinkButton}" Command="{Binding LimpiarCommand}"
                  Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding ResumenTotal}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Tabla abierta: doble clic o Enter abre la hoja de vida (NAV-006) -->
        <DataGrid x:Name="TablaEquipos" Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="60" Margin="0,8,0,0"
                  AutomationProperties.Name="Equipos biomédicos" ScrollViewer.CanContentScroll="False"
                  MouseDoubleClick="TablaEquipos_MouseDoubleClick" PreviewKeyDown="TablaEquipos_PreviewKeyDown">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="CÓDIGO DE ACTIVO" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontWeight="SemiBold" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <StackPanel>
                    <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tipo}" />
                    <TextBlock Text="{Binding Serie}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="RIESGO" Width="0.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Clase}" FontWeight="SemiBold" ToolTip="{Binding DescripcionClase}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="FABRICANTE" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Fabricante}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="UBICACIÓN" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <TextBlock Text="{Binding Ubicacion}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ubicacion}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoEstado}" />
                      <TextBlock Text="{Binding Estado}" />
                    </StackPanel>
                    <TextBlock x:Name="AvisoRegistro" Text="{Binding AvisoRegistro}" FontSize="12" Margin="16,1,0,0"
                               Foreground="{DynamicResource Brush.WarningText}"
                               Visibility="{Binding AvisoRegistro, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="PRÓX. MANTENIMIENTO" Width="1.2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaEquipo}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProximoMantenimiento}" />
                    <TextBlock Text="{Binding DetalleMantenimiento}" FontSize="12" Margin="6,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.WarningText}"
                               Visibility="{Binding DetalleMantenimiento, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Margin="0,24,0,0" Visibility="{Binding SinEquipos, Converter={StaticResource Visible}}">
          <TextBlock Text="No encontramos equipos con esos criterios" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="Prueba con otro código o quita algún filtro." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Pie: resumen y paginación -->
        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
