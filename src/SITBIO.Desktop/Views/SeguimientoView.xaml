<!-- UI-010 Seguimiento de tiquetes (HU-017; FLU-004). Página de lista + detalle: consulta por código, lista
     filtrada por estado y detalle con el estado actual y el historial de cambios (CA-HU-017-01). Para el
     Personal Clínico es «Mis tiquetes»: la API solo le devuelve lo que reportó (CA-HU-017-02). Solo
     lectura. Diseño clínico editorial: sin tarjetas; el estado es punto + texto. -->
<UserControl x:Class="Sitbio.Desktop.Views.SeguimientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <Style x:Key="CampoCodigo" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ErrorCodigo, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Punto según el tono del estado (Tono) o de la criticidad (TonoCriticidad) -->
    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PuntoCriticidad" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoCriticidad}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TonoCriticidad}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Detalle del tiquete con su línea de tiempo -->
    <DataTemplate DataType="{x:Type vm:DetalleTiquete}">
      <StackPanel>
        <TextBlock Text="{Binding Codigo}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                   AutomationProperties.Name="Código del tiquete" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Ellipse Style="{StaticResource PuntoEstado}" />
          <TextBlock Text="{Binding Estado}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                     AutomationProperties.Name="{Binding Estado, StringFormat='Estado {0}'}" />
        </StackPanel>

        <!-- RN-005 -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding EquipoFueraDeServicio, Converter={StaticResource Visible}}">
          <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Brush.Danger}" />
          <TextBlock Text="{Binding TextoFueraDeServicio}" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Datos -->
        <Grid Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,24,18">
            <TextBlock Text="Equipo" Style="{StaticResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding Equipo}" Foreground="{DynamicResource Brush.Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Serie}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,24,18">
            <TextBlock Text="Reportado por" Style="{StaticResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding Reporte}" Foreground="{DynamicResource Brush.Text}" FontSize="15" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,24,18">
            <TextBlock Text="Tipo de falla" Style="{StaticResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding TipoFalla}" Foreground="{DynamicResource Brush.Text}" FontSize="15" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,24,18">
            <TextBlock Text="Criticidad" Style="{StaticResource Muted}" FontSize="13" />
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource PuntoCriticidad}" />
              <TextBlock Text="{Binding Criticidad}" Foreground="{DynamicResource Brush.Text}" FontSize="15" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,0,24,18">
            <TextBlock Text="Descripción" Style="{StaticResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding Descripcion}" Foreground="{DynamicResource Brush.Text}" FontSize="15" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,24,18" Visibility="{Binding Cierre, Converter={StaticResource TextoVisible}}">
            <TextBlock Text="Cerrado" Style="{StaticResource Muted}" FontSize="13" />
            <TextBlock Text="{Binding Cierre}" Foreground="{DynamicResource Brush.Text}" FontSize="15" />
          </StackPanel>
        </Grid>

        <!-- Historial (CA-HU-017-01), del más reciente al más antiguo -->
        <TextBlock Text="Historial" Style="{StaticResource SectionTitle}" Margin="0,8,0,4" />
        <TextBlock Text="Cada cambio de estado del tiquete, con quién lo hizo." Style="{StaticResource Muted}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Historial}" Focusable="False" AutomationProperties.Name="Historial del tiquete">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PasoHistorial}">
              <Border Style="{StaticResource ListRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Fecha}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,16,0" />
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoEstado}" />
                      <TextBlock x:Name="Titulo" Text="{Binding Titulo}" Foreground="{DynamicResource Brush.Text}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Comentario}" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" Margin="16,2,0,0"
                               Visibility="{Binding Comentario, Converter={StaticResource TextoVisible}}" />
                    <TextBlock Text="{Binding Usuario}" Style="{StaticResource Muted}" FontSize="13" Margin="16,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EsActual}" Value="True">
                  <Setter TargetName="Titulo" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="40,24,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <!-- Aviso de error -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
              Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                          Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
            <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                    Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
            <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Detalle -->
      <StackPanel Visibility="{Binding Detalle, Converter={StaticResource NuloVisible}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Content="‹ Volver a la lista" Style="{StaticResource LinkButton}" Command="{Binding VolverCommand}"
                  AutomationProperties.Name="{Binding Titulo, StringFormat='Volver a {0}'}" />
        </StackPanel>
        <TextBlock Text="SOLICITUDES › SEGUIMIENTO" Style="{StaticResource Overline}" />
        <ContentControl Content="{Binding Detalle}" Focusable="False" IsTabStop="False" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- Lista -->
      <StackPanel Visibility="{Binding EnLista, Converter={StaticResource Visible}}">
        <TextBlock Text="SOLICITUDES" Style="{StaticResource Overline}" />
        <TextBlock Text="{Binding Titulo}" Style="{StaticResource PageTitle}" Margin="0,4,0,6" />
        <TextBlock Text="{Binding Descripcion}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,24" />

        <!-- Consulta por código -->
        <TextBlock Text="Código del tiquete" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource CampoCodigo}" Width="260">
            <TextBox Style="{StaticResource FieldInput}" FontFamily="Consolas" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Código del tiquete, por ejemplo TQT-000015">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConsultarCodigoCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </Border>
          <Button Content="Consultar" Style="{StaticResource PrimaryButton}" Command="{Binding ConsultarCodigoCommand}" Margin="12,0,0,0" />
          <TextBlock Text="Abriendo…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"
                     Visibility="{Binding Abriendo, Converter={StaticResource Visible}}" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorCodigo}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding ErrorCodigo, Converter={StaticResource TextoVisible}}" />

        <!-- Filtros -->
        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
          <ComboBox Style="{StaticResource FieldCombo}" Width="240" ItemsSource="{x:Static vm:SeguimientoViewModel.OpcionesEstado}"
                    SelectedItem="{Binding FiltroEstado}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por estado" />
          <CheckBox Content="Solo los que reporté" IsChecked="{Binding SoloMios}" VerticalAlignment="Center" Margin="20,0,0,0"
                    Style="{StaticResource Casilla}" Visibility="{Binding PuedeVerSoloMios, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!-- Tabla abierta, solo lectura -->
        <DataGrid x:Name="TablaTiquetes" Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58" Margin="0,12,0,0"
                  AutomationProperties.Name="Tiquetes" ScrollViewer.CanContentScroll="False"
                  MouseDoubleClick="TablaTiquetes_MouseDoubleClick" PreviewKeyDown="TablaTiquetes_PreviewKeyDown">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="CÓDIGO" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <StackPanel>
                    <TextBlock Text="{Binding Codigo}" FontFamily="Consolas" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Fecha}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <StackPanel>
                    <TextBlock Text="{Binding Equipo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                    <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="FALLA" Width="1.4*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <StackPanel>
                    <TextBlock Text="{Binding TipoFalla}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TipoFalla}" />
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoCriticidad}" />
                      <TextBlock Text="{Binding Criticidad}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="REPORTADO POR" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <TextBlock Text="{Binding Reportante}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reportante}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO" Width="1.1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" />
                    <TextBlock Text="{Binding Estado}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="0.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaTiquete}">
                  <Button Content="Ver detalle" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                          Command="{Binding DataContext.AbrirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Codigo, StringFormat='Ver detalle del tiquete {0}'}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Consultando los tiquetes…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
        <StackPanel Margin="0,24,0,0" Visibility="{Binding SinTiquetes, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding TextoSinTiquetes}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="Cuando se reporte una falla, su tiquete aparecerá aquí con su estado." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Pie: resumen y paginación -->
        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
