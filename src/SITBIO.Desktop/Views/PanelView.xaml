<!-- UI-003 Panel de inicio (prototipo Panel.tsx): saludo, cuatro indicadores, actividad de mantenimiento,
     «Atención requerida» y equipos con actividad reciente. Lo que el rol no consulta no se muestra. -->
<UserControl x:Class="Sitbio.Desktop.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sitbio.Desktop.Controls"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:RecursoConverter x:Key="Recurso" />

    <!-- Botón sin cromo: tarjetas e indicadores con destino -->
    <Style x:Key="BotonPlano" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Botón secundario pequeño («Descartar», «Ver reportes») -->
    <Style x:Key="BotonSecundario" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderControl}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Caja" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Caja" Property="Background" Value="{DynamicResource Brush.Surface2}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pastilla de prioridad según el tono -->
    <Style x:Key="Pastilla" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text2}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Exito}">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Info}">
          <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Advertencia}">
          <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Alto}">
          <Setter Property="Background" Value="{DynamicResource Brush.HighSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Critico}">
          <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.DangerText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Punto de estado del equipo -->
    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoEstado}" Value="{x:Static vm:TonoEstado.Exito}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TonoEstado}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TonoEstado}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Indicador de la franja (CMP-UI-012) -->
    <DataTemplate x:Key="PlantillaIndicador" DataType="{x:Type vm:TarjetaIndicador}">
      <Button Style="{StaticResource BotonPlano}" IsEnabled="{Binding TieneDestino}" AutomationProperties.Name="{Binding Titulo}"
              Command="{Binding DataContext.IrCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Destino}">
        <Border Style="{StaticResource KpiItem}">
          <StackPanel>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Valor}" Style="{StaticResource KpiValue}" Margin="0,4,0,2" />
            <TextBlock x:Name="Detalle" Text="{Binding Detalle}" FontSize="13" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Exito}">
          <Setter TargetName="Detalle" Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Advertencia}">
          <Setter TargetName="Detalle" Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoTarjeta.Critico}">
          <Setter TargetName="Detalle" Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="1240" HorizontalAlignment="Stretch">
      <!-- Encabezado -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource BotonSecundario}" Content="Ver reportes  →" Height="46" FontSize="15" Padding="20,0" Command="{Binding IrCommand}" CommandParameter="UI-021"
                  Visibility="{Binding PuedeVerReportes, Converter={StaticResource Visible}}" />
          <Button views:Boton.Icono="{StaticResource Icono.Agregar}" Style="{StaticResource PrimaryButton}" Content="Registrar equipo" Command="{Binding IrCommand}" CommandParameter="UI-005" Margin="12,0,0,0"
                  Visibility="{Binding PuedeRegistrarEquipo, Converter={StaticResource Visible}}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Institucion}" Style="{StaticResource Overline}" Visibility="{Binding Institucion, Converter={StaticResource TextoVisible}}" />
          <TextBlock Text="{Binding Saludo}" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>

      <TextBlock Text="Cargando el panel…" Style="{StaticResource Muted}" Margin="0,16,0,0" Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

      <!-- Error parcial -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}" Margin="0,16,0,0"
              Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" AutomationProperties.LiveSetting="Assertive">
        <DockPanel>
          <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" DockPanel.Dock="Right" Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" VerticalAlignment="Bottom" />
          <StackPanel>
            <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" />
            <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.25*" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <!-- Cuatro indicadores -->
          <Border Style="{StaticResource KpiStrip}">
            <ItemsControl ItemsSource="{Binding Indicadores}" ItemTemplate="{StaticResource PlantillaIndicador}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </Border>

          <!-- Actividad de mantenimiento (roles con órdenes) -->
          <StackPanel Margin="0,28,0,0" Visibility="{Binding VeOrdenes, Converter={StaticResource Visible}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Source={x:Static vm:PanelViewModel.Periodos}}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OpcionPeriodo}">
                      <RadioButton Style="{StaticResource Pestana}" GroupName="PeriodoPanel" Content="{Binding Texto}"
                                   Command="{Binding DataContext.CambiarPeriodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding Clave}" Loaded="Periodo_Loaded" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Actividad de mantenimiento" Style="{StaticResource SectionTitle}" />
                <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource Brush.Primary}" Margin="20,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Preventivos" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{DynamicResource Brush.Jade}" Margin="14,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Correctivos" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>

            <!-- Gráfico de líneas con etiqueta al pasar el mouse (componente de gráficos, I-01) -->
            <controls:Grafico Height="200" Margin="0,12,0,0" Tipo="Linea" MostrarLeyenda="False"
                              Etiquetas="{Binding EtiquetasActividad}" Series="{Binding SeriesActividad}"
                              AutomationProperties.Name="Preventivos y correctivos cerrados por periodo" />

            <!-- Actividad reciente -->
            <ItemsControl ItemsSource="{Binding Recientes}" Margin="0,14,0,0" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ActividadReciente}">
                  <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Pastilla}" Width="32" Height="32" CornerRadius="9" Padding="0" Margin="0,0,12,0">
                        <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}" Width="16" Height="16" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding Detalle}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{DynamicResource Brush.Surface2}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tipo}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                      </Border>
                      <TextBlock Grid.Column="3" Text="{Binding Cuando}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Indicadores del periodo (roles sin órdenes) -->
          <StackPanel Margin="0,28,0,0" Visibility="{Binding MuestraIndicadoresPeriodo, Converter={StaticResource Visible}}">
            <TextBlock Text="Indicadores de los últimos 30 días" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <Border Style="{StaticResource KpiStrip}">
              <ItemsControl ItemsSource="{Binding IndicadoresPeriodo}" ItemTemplate="{StaticResource PlantillaIndicador}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Atención requerida -->
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Atención requerida" Style="{StaticResource SectionTitle}" />
            <Border CornerRadius="10" Padding="8,1" Margin="10,0,0,0" Background="{DynamicResource Brush.DangerSoft}" VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Atencion.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding Atencion.Count}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" />
            </Border>
          </StackPanel>

          <StackPanel Margin="0,32,0,0" HorizontalAlignment="Center" Visibility="{Binding SinAtencion, Converter={StaticResource Visible}}">
            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Brush.SuccessSoft}" HorizontalAlignment="Center">
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}" Width="24" Height="24" Foreground="{DynamicResource Brush.SuccessText}" />
            </Border>
            <TextBlock Text="Todo al día" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="No hay pendientes que requieran tu atención." Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Atencion}" Margin="0,12,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TarjetaAtencion}">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                        Background="{DynamicResource Brush.Surface}" Padding="14,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Ficha con el ícono del tipo de alerta, del tono de la prioridad -->
                    <Border Style="{StaticResource Pastilla}" Width="36" Height="36" CornerRadius="10" Padding="0" VerticalAlignment="Top" Margin="0,0,12,0">
                      <ContentControl Style="{StaticResource Icono}" Content="{Binding Icono, Converter={StaticResource Recurso}}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Reloj}" Width="12" Height="12" Margin="0,0,4,0"
                                          Foreground="{DynamicResource Brush.Text3}" />
                          <TextBlock Text="{Binding Cuando}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Tipo}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                          <Border Style="{StaticResource Pastilla}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Prioridad}" FontSize="12" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding Descripcion}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <!-- Acciones pequeñas: «Ver detalle» (acento con ojo) y «Descartar» (secundario) -->
                      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Height="30" FontSize="13" Padding="10,0"
                                Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Titulo, StringFormat='Ver detalle: {0}'}">
                          <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Ojo}" Width="14" Height="14" Margin="0,0,6,0"
                                            Foreground="{DynamicResource Brush.OnPrimary}" />
                            <TextBlock Text="Ver detalle" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BotonSecundario}" Content="Descartar" Height="30" FontSize="13" Padding="10,0" Margin="8,0,0,0"
                                Command="{Binding DataContext.DescartarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Titulo, StringFormat='Descartar: {0}'}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- Equipos con actividad reciente -->
      <StackPanel Margin="0,32,0,0" Visibility="{Binding VeEquipos, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ver todos los equipos  →" Command="{Binding IrCommand}" CommandParameter="UI-005" />
          <TextBlock Text="Equipos con actividad reciente" Style="{StaticResource SectionTitle}" />
        </DockPanel>
        <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding EquiposRecientes}" RowHeight="56" Margin="0,8,0,0"
                  AutomationProperties.Name="Equipos con actividad reciente" ScrollViewer.CanContentScroll="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="CÓDIGO DE ACTIVO" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:EquipoReciente}">
                  <TextBlock Text="{Binding Placa}" FontFamily="Consolas" FontWeight="SemiBold" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO BIOMÉDICO" Width="1.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:EquipoReciente}">
                  <StackPanel>
                    <TextBlock Text="{Binding TipoEquipo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MarcaModelo}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="UBICACIÓN" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:EquipoReciente}">
                  <TextBlock Text="{Binding Ubicacion}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO OPERATIVO" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:EquipoReciente}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" />
                    <TextBlock Text="{Binding Estado}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="PRÓXIMO MANTENIMIENTO" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:EquipoReciente}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProximoMantenimiento}" />
                    <TextBlock Text="{Binding AvisoProximo}" FontSize="12" Margin="6,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.WarningText}"
                               Visibility="{Binding AvisoProximo, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Aún no hay equipos con órdenes recientes." Margin="0,12,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding EquiposRecientes.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
