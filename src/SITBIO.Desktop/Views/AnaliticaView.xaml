<!-- UI-023 Analítica (HU-008, HU-009; prototipo Analitica, I-05): dispersión de equipos con ejes elegibles, grupos K-Means con
     nombre, etiqueta al pasar el mouse, clic que abre la hoja de vida, «Gráfico / Tabla de datos» (J-01), «Cómo leerlo»,
     «Recalcular» y «Exportar resultado». -->
<UserControl x:Class="Sitbio.Desktop.Views.AnaliticaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Sitbio.Desktop.Controls"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:RecursoConverter x:Key="Recurso" />

    <!-- Aviso rojo si es un error; azul si es informativo -->
    <Style x:Key="AvisoBarra" TargetType="Border" BasedOn="{StaticResource InfoBar}">
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsError}" Value="False">
          <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AvisoTitulo" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsError}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource Brush.InfoText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
      <TextBlock Text="ANÁLISIS" Style="{StaticResource Overline}" />
      <TextBlock Text="Analítica de equipos" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                 Text="Agrupa los equipos por comportamiento (fallas, costo y tiempo de atención) para priorizar mantenimiento y reposición." />

      <!-- Aviso de carga o de recálculo -->
      <Border DataContext="{Binding Aviso}" Style="{StaticResource AvisoBarra}" Margin="0,0,0,16"
              Visibility="{Binding DataContext.Aviso, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NuloVisible}}">
        <DockPanel>
          <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" DockPanel.Dock="Right" Content="Reintentar" Style="{StaticResource LinkButton}" VerticalAlignment="Bottom"
                  Command="{Binding DataContext.CargarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <StackPanel>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource AvisoTitulo}" />
            <TextBlock Text="{Binding Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Confirmación (recalculado o exportado) -->
      <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}" Margin="0,0,0,16"
              Visibility="{Binding Confirmacion, Converter={StaticResource NuloVisible}}">
        <StackPanel>
          <TextBlock Text="{Binding Confirmacion.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" />
          <TextBlock Text="{Binding Confirmacion.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Text="Cargando la analítica…" Style="{StaticResource Muted}" Margin="0,0,0,16" Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

      <!-- Controles: número de grupos, ejes y recalcular -->
      <Border Style="{StaticResource Section}" Margin="0,0,0,20">
        <DockPanel LastChildFill="False">
          <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" views:Boton.Icono="{StaticResource Icono.Recalcular}"
                  Command="{Binding RecalcularCommand}" Visibility="{Binding PuedeRecalcular, Converter={StaticResource Visible}}"
                  AutomationProperties.Name="Recalcular la analítica">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Content" Value="Recalcular" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Recalculando}" Value="True">
                    <Setter Property="Content" Value="Calculando…" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <StackPanel Orientation="Horizontal" Visibility="{Binding HayDatos, Converter={StaticResource Visible}}">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Número de grupos" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource FieldCombo}" Width="90" ItemsSource="{x:Static vm:AnaliticaViewModel.OpcionesGrupos}"
                        SelectedItem="{Binding GruposSolicitados}" AutomationProperties.Name="Número de grupos" />
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Eje horizontal" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource FieldCombo}" Width="220" ItemsSource="{x:Static vm:AnaliticaViewModel.OpcionesEje}"
                        DisplayMemberPath="Nombre" SelectedItem="{Binding EjeX}" AutomationProperties.Name="Eje horizontal" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Eje vertical" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource FieldCombo}" Width="220" ItemsSource="{x:Static vm:AnaliticaViewModel.OpcionesEje}"
                        DisplayMemberPath="Nombre" SelectedItem="{Binding EjeY}" AutomationProperties.Name="Eje vertical" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Número de grupos (CA-HU-009-02) -->
      <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
              Visibility="{Binding AvisoGrupos, Converter={StaticResource NuloVisible}}">
        <StackPanel>
          <TextBlock Text="{Binding AvisoGrupos.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" />
          <TextBlock Text="{Binding AvisoGrupos.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
      </Border>

      <Grid Visibility="{Binding HayAgrupacion, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.6*" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Dispersión -->
        <Border Style="{StaticResource Section}" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Puntos.Count, StringFormat='{}{0} equipos'}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Dispersion}" Width="16" Height="16" Foreground="{DynamicResource Brush.Text2}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding TituloGrafico}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Vista:" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
              <RadioButton Style="{StaticResource Pestana}" GroupName="VistaAnalitica" Content="Gráfico" IsChecked="{Binding VistaGrafico}" />
              <RadioButton Style="{StaticResource Pestana}" GroupName="VistaAnalitica" Content="Tabla de datos" IsChecked="{Binding VistaTabla}" />
            </StackPanel>
            <controls:Grafico views:Animacion.Crecer="True" Tipo="Dispersion" Height="380" Margin="0,14,0,0" FormatoValor="0.##"
                              Visibility="{Binding VistaGrafico, Converter={StaticResource Visible}}"
                              Series="{Binding SeriesGrupos}" Puntos="{Binding Puntos}"
                              TituloEjeX="{Binding TituloEjeX}" TituloEjeY="{Binding TituloEjeY}"
                              ComandoPunto="{Binding AbrirEquipoCommand}"
                              AutomationProperties.Name="Dispersión de los equipos por grupo; las tarjetas de la derecha resumen cada grupo" />

            <!-- Tabla de datos: un equipo por fila, con los valores de los ejes elegidos -->
            <StackPanel Margin="0,14,0,0" Visibility="{Binding VistaTabla, Converter={StaticResource Visible}}">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.3*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PLACA" Style="{StaticResource Overline}" />
                <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Overline}" />
                <TextBlock Grid.Column="2" Text="GRUPO" Style="{StaticResource Overline}" />
                <TextBlock Grid.Column="3" Text="{Binding TituloEjeX}" Style="{StaticResource Overline}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TituloEjeX}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="{Binding TituloEjeY}" Style="{StaticResource Overline}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TituloEjeY}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FilasTabla}" Focusable="False" AutomationProperties.Name="Equipos con su grupo y los valores de los ejes elegidos">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaEquipoAnalitica}">
                    <Border Padding="0,10">
                      <Border.Style>
                        <!-- Como las filas de I-09: si el rol abre la hoja de vida, cursor de mano y fondo al pasar el mouse -->
                        <Style TargetType="Border" BasedOn="{StaticResource ListRow}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.PuedeAbrirEquipos, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                              <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.AbrirEquipoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </Border.InputBindings>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1.3*" />
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="1.1*" />
                          <ColumnDefinition Width="1.1*" />
                          <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Placa}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Grid.Column="1" Text="{Binding Tipo}" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <DockPanel Grid.Column="2" Margin="0,0,8,0">
                          <Ellipse Width="8" Height="8" Fill="{Binding ClaveColor, Converter={StaticResource Recurso}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Grupo}" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Grupo}" />
                        </DockPanel>
                        <TextBlock Grid.Column="3" Text="{Binding ValorX}" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Grid.Column="4" Text="{Binding ValorY}" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Grid.Column="5" Text="›" FontSize="16" Foreground="{DynamicResource Brush.Text3}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.PuedeAbrirEquipos, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <!-- Una tarjeta por grupo, del de más fallas al de menos -->
          <ItemsControl ItemsSource="{Binding Resumen}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FilaGrupo}">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{Binding ClaveColor, Converter={StaticResource Recurso}}" BorderThickness="4,0,0,0"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface2}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Equipos}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                      </Border>
                      <Ellipse Width="10" Height="10" Fill="{Binding ClaveColor, Converter={StaticResource Recurso}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="3" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Text="Fallas" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding Fallas}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Costo medio" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding Costo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Atención" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="{Binding Tiempo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Cómo leerlo -->
          <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Info}">
            <DockPanel>
              <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Info}" Width="16" Height="16" Foreground="{DynamicResource Brush.InfoText}"
                              VerticalAlignment="Top" Margin="0,2,10,0" />
              <StackPanel>
                <TextBlock Text="Cómo leerlo" FontWeight="SemiBold" Foreground="{DynamicResource Brush.InfoText}" />
                <TextBlock Text="{Binding ComoLeerlo}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Button views:Boton.Icono="{StaticResource Icono.Descargar}" Style="{StaticResource LinkButton}" Content="Exportar resultado" HorizontalAlignment="Left"
                  Margin="0,14,0,0" Command="{Binding ExportarCommand}" AutomationProperties.Name="Exportar el grupo de cada equipo a un archivo CSV" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,18,0,0" Visibility="{Binding HayDatos, Converter={StaticResource Visible}}">
        <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Info}" Width="14" Height="14" Foreground="{DynamicResource Brush.Text3}" Margin="0,0,6,0" />
        <TextBlock Text="{Binding Encabezado}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
