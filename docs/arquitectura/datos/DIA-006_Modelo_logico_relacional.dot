ft"><font point-size="8.5">fecha_calibracion</font></td><td align="left"><font point-size="8" color="#666666">date NN</font></td></tr><tr><td align="left"><font point-size="8" color="#24496D"> </font></td><td align="left"><font point-size="8.5">patron_referencia</font></td><td align="left"><font point-size="8" color="#666666">varchar NN</font></td></tr><tr><td align="left"><font point-size="8" color="#24496D"> </font></td><td align="left"><font point-size="8.5">resultado</font></td><td align="left"><font point-size="8" color="#666666">varchar NN</font></td></tr><tr><td align="left"><font point-size="8" color="#24496D"> </font></td><td align="left"><font point-size="8.5">numero_certificado</font></td><td align="left"><font point-size="8" color="#666666">varchar</font></td></tr><tr><td align="left"><font point-size="8" color="#24496D"> </font></td><td align="left"><font point-size="8.5">fecha_vencimiento</font></td><td align="left"><font point-size="8" color="#666666">date NN</font></td></tr></table>>];
  }
  documento_equipo -> calibracion [tooltip="calibracion.documento_id"];
  equipo_biomedico -> calibracion [tooltip="calibracion.equipo_id"];
  orden_trabajo -> calibracion [tooltip="calibracion.orden_id"];
  proveedor -> calibracion [tooltip="calibracion.proveedor_id"];
  equipo_biomedico -> documento_equipo [tooltip="documento_equipo.equipo_id"];
  estado_equipo -> equipo_biomedico [tooltip="equipo_biomedico.estado_equipo_id"];
  documento_equipo -> equipo_biomedico [tooltip="equipo_biomedico.foto_documento_id", style=dashed];
  proveedor -> equipo_biomedico [tooltip="equipo_biomedico.proveedor_id"];
  tipo_equipo -> equipo_biomedico [tooltip="equipo_biomedico.tipo_equipo_id"];
  ubicacion -> equipo_biomedico [tooltip="equipo_biomedico.ubicacion_id"];
  equipo_biomedico -> historial_estado_equipo [tooltip="historial_estado_equipo.equipo_id"];
  estado_equipo -> historial_estado_equipo [tooltip="historial_estado_equipo.estado_anterior_id"];
  estado_equipo -> historial_estado_equipo [tooltip="historial_estado_equipo.nuevo_estado_id"];
  tiquete -> historial_tiquete [tooltip="historial_tiquete.tiquete_id"];
  equipo_biomedico -> orden_trabajo [tooltip="orden_trabajo.equipo_id"];
  plan_preventivo -> orden_trabajo [tooltip="orden_trabajo.plan_id"];
  usuario -> orden_trabajo [tooltip="orden_trabajo.tecnico_id"];
  tiquete -> orden_trabajo [tooltip="orden_trabajo.tiquete_id"];
  equipo_biomedico -> plan_preventivo [tooltip="plan_preventivo.equipo_id"];
  usuario -> sesion_token [tooltip="sesion_token.usuario_id"];
  equipo_biomedico -> tiquete [tooltip="tiquete.equipo_id"];
  usuario -> tiquete [tooltip="tiquete.reportante_id"];
  rol -> usuario [tooltip="usuario.rol_id"];
  legend [shape=plaintext, margin=0, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#B5B5B5">
   <tr><td colspan="2" align="left"><font point-size="9"><b>Leyenda</b></font></td></tr>
   <tr><td><font point-size="8.5"><b>PK</b> / <b>FK</b></font></td><td align="left"><font point-size="8.5">Clave primaria (subrayada) / clave foránea (cursiva)</font></td></tr>
   <tr><td><font point-size="8.5">[T]</font></td><td align="left"><font point-size="8.5">Tabla con tenant_id (FK a tenant, no dibujada) y unicidad por institución</font></td></tr>
   <tr><td><font point-size="8.5">FK*</font></td><td align="left"><font point-size="8.5">Autores y aprobadores (*_por_id, usuario_id de historiales): FK a usuario, no dibujadas</font></td></tr>
   <tr><td><font point-size="8.5">┤ — &lt;</font></td><td align="left"><font point-size="8.5">Uno a muchos: el pie de gallo señala el lado «muchos»</font></td></tr>
   <tr><td><font point-size="8.5" color="#8C8C8C">- -</font></td><td align="left"><font point-size="8.5">FK con ON DELETE SET NULL (foto del equipo)</font></td></tr>
   <tr><td><font point-size="8.5">NN</font></td><td align="left"><font point-size="8.5">Columna obligatoria (NOT NULL)</font></td></tr>
  </table>>];
}