<Window x:Class="Sitbio.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
        xmlns:views="clr-namespace:Sitbio.Desktop.Views"
        Title="{Binding Titulo}"
        Icon="{DynamicResource Logo.Iso}"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:LoginViewModel}">
      <views:LoginView />
    </DataTemplate>
    <!-- Provisional: el commit 11 la reemplaza por el riel y el panel de navegación según el rol -->
    <DataTemplate DataType="{x:Type vm:SesionIniciadaViewModel}">
      <StackPanel Margin="48" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="Sesión iniciada" Style="{StaticResource PageTitle}" />
        <Border Style="{StaticResource Section}" Margin="0,16,0,0">
          <TextBlock Style="{StaticResource Muted}">
            <Run Text="Rol:" /> <Run Text="{Binding Rol, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <ContentControl Content="{Binding VistaActual}" Focusable="False" />
</Window>
