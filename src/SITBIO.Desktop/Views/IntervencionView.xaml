<!-- UI-013 Intervención (HU-005, HU-006). Hoja de servicio de la orden: datos fijos (diagnóstico, acciones,
     repuestos, costos, tiempo y estado de salida) y los campos dinámicos de la versión activa del tipo de
     equipo, cada uno con el control de su tipoDato. Los errores van junto a cada campo; sin permiso de
     edición, el formulario queda en solo lectura. -->
<UserControl x:Class="Sitbio.Desktop.Views.IntervencionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <!-- Casilla con borde rojo si su Tag (el error) tiene texto. -->
    <Style x:Key="CampoValidado" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- Acciones -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="40,14">
      <DockPanel MaxWidth="1000">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Guardando…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                     Visibility="{Binding Guardando, Converter={StaticResource Visible}}" />
          <Button Content="Volver a las órdenes" Style="{StaticResource LinkButton}" Command="{Binding CancelarCommand}" Margin="0,0,20,0" />
          <Button Content="Guardar intervención" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}"
                  Visibility="{Binding Editable, Converter={StaticResource Visible}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Costo total" Style="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CostoTotal}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                     AutomationProperties.Name="{Binding CostoTotal, StringFormat='Costo total {0}'}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="40,24,40,40" MaxWidth="1000" HorizontalAlignment="Stretch">
        <TextBlock Text="TRABAJO · INTERVENCIÓN" Style="{StaticResource Overline}" />
        <TextBlock Text="{Binding Referencia, StringFormat='Orden {0}'}" Style="{StaticResource PageTitle}" Margin="0,4,0,6" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18">
          <Run Text="{Binding Equipo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EstadoOrden, Mode=OneWay}" />
        </TextBlock>

        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Solo lectura o versión de campos -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                Margin="0,0,0,18" Visibility="{Binding Nota, Converter={StaticResource TextoVisible}}">
          <TextBlock Text="{Binding Nota}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Abriendo la intervención…" Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />

        <StackPanel IsEnabled="{Binding Editable}">
          <!-- Hoja de servicio -->
          <Border Style="{StaticResource Section}" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="Hoja de servicio" Style="{StaticResource SectionTitle}" FontSize="16" />

              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6">
                <Run Text="Diagnóstico" /><Run Text=" *" Foreground="{DynamicResource Brush.DangerText}" />
              </TextBlock>
              <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorDiagnostico}" Height="Auto">
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Diagnostico, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top" Padding="0,8" MaxLength="4000"
                         AutomationProperties.Name="Diagnóstico, obligatorio" />
              </Border>
              <TextBlock Text="{Binding ErrorDiagnostico}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                         Visibility="{Binding ErrorDiagnostico, Converter={StaticResource TextoVisible}}" />

              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6">
                <Run Text="Acciones realizadas" /><Run Text=" *" Foreground="{DynamicResource Brush.DangerText}" />
              </TextBlock>
              <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorAcciones}" Height="Auto">
                <TextBox Style="{StaticResource FieldInput}" Text="{Binding AccionesRealizadas, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top" Padding="0,8" MaxLength="4000"
                         AutomationProperties.Name="Acciones realizadas, obligatorio" />
              </Border>
              <TextBlock Text="{Binding ErrorAcciones}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                         Visibility="{Binding ErrorAcciones, Converter={StaticResource TextoVisible}}" />

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Tiempo de atención (minutos)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorTiempo}">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding TiempoAtencion, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Tiempo de atención en minutos" />
                  </Border>
                  <TextBlock Text="{Binding ErrorTiempo}" Style="{StaticResource FieldError}"
                             Visibility="{Binding ErrorTiempo, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Mano de obra (COP)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <Border Style="{StaticResource CampoValidado}" Tag="{Binding ErrorManoObra}">
                    <TextBox Style="{StaticResource FieldInput}" Text="{Binding CostoManoObra, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Costo de mano de obra en pesos" />
                  </Border>
                  <TextBlock Text="{Binding ErrorManoObra}" Style="{StaticResource FieldError}"
                             Visibility="{Binding ErrorManoObra, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Estado del equipo al salir" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                  <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:IntervencionViewModel.OpcionesSalida}"
                            SelectedItem="{Binding EstadoSalida}" AutomationProperties.Name="Estado del equipo al salir" />
                  <TextBlock Text="{Binding ErrorSalida}" Style="{StaticResource FieldError}"
                             Visibility="{Binding ErrorSalida, Converter={StaticResource TextoVisible}}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Repuestos -->
          <Border Style="{StaticResource Section}" Margin="0,0,0,18">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Agregar repuesto" Style="{StaticResource LinkButton}" Command="{Binding AgregarRepuestoCommand}" />
                <TextBlock Text="Repuestos" Style="{StaticResource SectionTitle}" FontSize="16" />
              </DockPanel>
              <TextBlock Text="Sin repuestos. Agrega los que usaste; el costo unitario es opcional." Style="{StaticResource Muted}" Margin="0,10,0,0"
                         Visibility="{Binding SinRepuestos, Converter={StaticResource Visible}}" />
              <Grid Margin="0,12,0,-4" Visibility="{Binding HayRepuestos, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Repuesto" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Column="2" Text="Cantidad" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Column="4" Text="Costo unitario (COP, opcional)" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Repuestos}" Focusable="False" IsTabStop="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:FilaRepuesto}">
                    <StackPanel Margin="0,8,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="3*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="1.4*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CampoValidado}" Tag="{Binding Error}">
                          <TextBox Style="{StaticResource FieldInput}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                                   AutomationProperties.Name="Nombre del repuesto" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource FieldBox}">
                          <TextBox Style="{StaticResource FieldInput}" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="Cantidad" />
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource FieldBox}">
                          <TextBox Style="{StaticResource FieldInput}" Text="{Binding CostoUnitario, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="Costo unitario en pesos, opcional" />
                        </Border>
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Command="{Binding DataContext.QuitarRepuestoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Nombre, StringFormat='Quitar el repuesto {0}'}">
                          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
                        </Button>
                      </Grid>
                      <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}"
                                 Visibility="{Binding Error, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ErrorRepuestos}" Style="{StaticResource FieldError}"
                         Visibility="{Binding ErrorRepuestos, Converter={StaticResource TextoVisible}}" />
            </StackPanel>
          </Border>

          <!-- Campos dinámicos del tipo de equipo (HU-006) -->
          <Border Style="{StaticResource Section}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" FontSize="16">
                <Run Text="Datos del tipo de equipo" /><Run Text="{Binding VersionCampos, StringFormat=' · versión {0}', Mode=OneWay}" Foreground="{DynamicResource Brush.Text2}" FontWeight="Normal" />
              </TextBlock>
              <TextBlock Text="{x:Static vm:IntervencionViewModel.SinCamposDinamicos}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                         Visibility="{Binding SinCampos, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding Campos}" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CampoIntervencion}">
                    <StackPanel Margin="0,14,0,0">
                      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6">
                        <Run Text="{Binding Etiqueta, Mode=OneWay}" /><Run x:Name="Asterisco" Text="" Foreground="{DynamicResource Brush.DangerText}" />
                      </TextBlock>
                      <!-- Sí / No -->
                      <StackPanel Orientation="Horizontal" Visibility="{Binding EsBooleano, Converter={StaticResource Visible}}">
                        <RadioButton Content="Sí" IsChecked="{Binding Si}" Margin="0,0,20,0" Foreground="{DynamicResource Brush.Text}"
                                     AutomationProperties.Name="{Binding Etiqueta, StringFormat='{}{0}: sí'}" />
                        <RadioButton Content="No" IsChecked="{Binding No}" Foreground="{DynamicResource Brush.Text}"
                                     AutomationProperties.Name="{Binding Etiqueta, StringFormat='{}{0}: no'}" />
                      </StackPanel>
                      <!-- Selección -->
                      <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Opciones}" SelectedItem="{Binding Opcion}"
                                Visibility="{Binding EsSeleccion, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Etiqueta}" />
                      <!-- Número, texto o fecha -->
                      <Border Style="{StaticResource CampoValidado}" Tag="{Binding Error}" Visibility="{Binding EsTextoLibre, Converter={StaticResource Visible}}">
                        <TextBox Style="{StaticResource FieldInput}" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                 AutomationProperties.Name="{Binding Etiqueta}" AutomationProperties.HelpText="{Binding Ayuda}" />
                      </Border>
                      <TextBlock Text="{Binding Ayuda}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                                 Visibility="{Binding Ayuda, Converter={StaticResource TextoVisible}}" />
                      <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                                 Visibility="{Binding Error, Converter={StaticResource TextoVisible}}" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Campo.Obligatorio}" Value="True">
                        <Setter TargetName="Asterisco" Property="Text" Value=" *" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
