<!-- UI-011 Bandeja de tiquetes y asignación (HU-004, HU-018; FLU-004). Página + panel lateral: los tiquetes
     «recibidos» de lo más crítico a lo menos crítico y, al elegir uno, el panel de asignación con los
     técnicos activos y su carga (RN-003). Al asignar, el panel se cierra y la fila pasa a «asignado»
     (NAV-008). La criticidad es punto + texto, no solo color (ACC-001). -->
<UserControl x:Class="Sitbio.Desktop.Views.BandejaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />

    <Style x:Key="PuntoEstado" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tono}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PuntoCriticidad" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TonoCriticidad}" Value="{x:Static vm:TonoEstado.Advertencia}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TonoCriticidad}" Value="{x:Static vm:TonoEstado.Critico}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CampoFecha" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ErrorFecha, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Técnico del panel: nombre y carga; el elegido se marca con borde y fondo, y con el texto «Elegido». -->
    <Style x:Key="FilaTecnicoItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocoTeclado}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Nombre, StringFormat='Técnico {0}'}" />
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Carga}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Caja" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Field}" Padding="12,9" Margin="0,0,0,6">
              <DockPanel>
                <TextBlock x:Name="Marca" DockPanel.Dock="Right" Text="Elegido" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel>
                  <TextBlock Text="{Binding Nombre}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Carga}" Style="{StaticResource Muted}" FontSize="13" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                <Setter TargetName="Caja" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Bandeja -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="40,24,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Aviso.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              </DockPanel>
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,16,0"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Confirmación de la asignación -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.SuccessSoft}" BorderBrush="{DynamicResource Brush.Success}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding Exito, Converter={StaticResource TextoVisible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarExitoCommand}" Margin="16,0,0,0" />
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Check}"
                            Foreground="{DynamicResource Brush.SuccessText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <TextBlock Text="{Binding Exito}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <TextBlock Text="SOLICITUDES" Style="{StaticResource Overline}" />
        <TextBlock Text="Bandeja de tiquetes" Style="{StaticResource PageTitle}" Margin="0,4,0,6" />
        <TextBlock Text="Los tiquetes que esperan técnico, de lo más crítico a lo menos crítico. Elige uno para asignar su orden de trabajo."
                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20" />

        <!-- RN-003: sin técnicos activos no hay a quién asignar -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                Margin="0,0,0,18" Visibility="{Binding SinTecnicos, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static vm:BandejaViewModel.SinTecnicosActivos}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="TablaBandeja" Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="58"
                  AutomationProperties.Name="Tiquetes por asignar" ScrollViewer.CanContentScroll="False"
                  MouseDoubleClick="TablaBandeja_MouseDoubleClick" PreviewKeyDown="TablaBandeja_PreviewKeyDown">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="CRITICIDAD" Width="0.9*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoCriticidad}" />
                    <TextBlock Text="{Binding Criticidad}" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="CÓDIGO" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <StackPanel>
                    <TextBlock Text="{Binding Codigo}" FontFamily="Consolas" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Reporte}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Reporte}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <StackPanel>
                    <TextBlock Text="{Binding Equipo}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                    <TextBlock Text="{Binding Ubicacion}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="FALLA" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <StackPanel>
                    <TextBlock Text="{Binding TipoFalla}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TipoFalla}" />
                    <TextBlock Text="Equipo fuera de servicio" FontSize="12" Foreground="{DynamicResource Brush.DangerText}"
                               Visibility="{Binding EquipoFueraDeServicio, Converter={StaticResource Visible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO" Width="1.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource PuntoEstado}" />
                    <TextBlock Text="{Binding Estado}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Estado}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="0.8*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaBandeja}">
                  <Button Content="Asignar" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                          Visibility="{Binding PorAsignar, Converter={StaticResource Visible}}"
                          Command="{Binding DataContext.AbrirAsignacionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Codigo, StringFormat='Asignar el tiquete {0}'}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Consultando la bandeja…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
        <StackPanel Margin="0,24,0,0" Visibility="{Binding SinTiquetes, Converter={StaticResource Visible}}">
          <TextBlock Text="No hay tiquetes por asignar." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock Text="Cuando se reporte una falla, aparecerá aquí para que la asignes a un técnico." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Actualizar" Style="{StaticResource LinkButton}" Command="{Binding CargarCommand}" Margin="0,0,20,0" />
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Panel de asignación -->
    <Border Grid.Column="1" Width="380" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
            Visibility="{Binding PanelAbierto, Converter={StaticResource Visible}}" AutomationProperties.Name="Panel de asignación">
      <DockPanel>
        <!-- Acciones -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,14">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Asignando…" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Visibility="{Binding Asignando, Converter={StaticResource Visible}}" />
            <Button Content="Cancelar" Style="{StaticResource LinkButton}" Command="{Binding CerrarPanelCommand}" Margin="0,0,20,0" />
            <Button Content="Asignar y crear orden" Style="{StaticResource PrimaryButton}" Command="{Binding AsignarCommand}" IsDefault="True" />
          </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="24,24,24,24">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CerrarPanelCommand}"
                      AutomationProperties.Name="Cerrar el panel de asignación" VerticalAlignment="Top">
                <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Cerrar}" />
              </Button>
              <TextBlock Text="ASIGNAR ORDEN" Style="{StaticResource Overline}" />
            </DockPanel>
            <TextBlock Text="{Binding Seleccionado.Codigo}" FontFamily="Consolas" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Seleccionado.Equipo}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Seleccionado.TipoFalla}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" DataContext="{Binding Seleccionado}">
              <Ellipse Style="{StaticResource PuntoCriticidad}" />
              <TextBlock Text="{Binding Criticidad, StringFormat='Criticidad {0}'}" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>

            <!-- Error de la asignación (conflicto, permiso, servidor) -->
            <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                    Margin="0,18,0,0" AutomationProperties.LiveSetting="Assertive"
                    Visibility="{Binding AvisoPanel, Converter={StaticResource NuloVisible}}">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding AvisoPanel.Codigo}" Style="{StaticResource Overline}" Margin="8,2,0,0" />
                  <TextBlock Text="{Binding AvisoPanel.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding AvisoPanel.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>

            <!-- Técnico (RN-003: solo activos) -->
            <TextBlock Text="Técnico" Style="{StaticResource FieldLabel}" Margin="0,22,0,2" />
            <TextBlock Text="Solo aparecen los técnicos activos. La carga son sus órdenes abiertas." Style="{StaticResource Muted}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding TecnicoElegido}" ItemContainerStyle="{StaticResource FilaTecnicoItem}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Técnicos activos con su carga" />
            <TextBlock Text="{Binding ErrorTecnicos}" Style="{StaticResource FieldError}"
                       Visibility="{Binding ErrorTecnicos, Converter={StaticResource TextoVisible}}" />
            <TextBlock Text="{x:Static vm:BandejaViewModel.SinTecnicosActivos}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Visibility="{Binding SinTecnicos, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding ErrorTecnico}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding ErrorTecnico, Converter={StaticResource TextoVisible}}" />

            <!-- Prioridad (por defecto, la sugerida por la criticidad) -->
            <TextBlock Text="Prioridad" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:BandejaViewModel.OpcionesPrioridad}"
                      SelectedItem="{Binding Prioridad}" DisplayMemberPath="Texto" AutomationProperties.Name="Prioridad de la orden" />
            <TextBlock Text="Sugerida por la criticidad del reporte; puedes cambiarla." Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorPrioridad}" Style="{StaticResource FieldError}"
                       Visibility="{Binding ErrorPrioridad, Converter={StaticResource TextoVisible}}" />

            <!-- Fecha programada (opcional) -->
            <TextBlock Text="Fecha programada (opcional)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
            <Border Style="{StaticResource CampoFecha}" Width="180" HorizontalAlignment="Left">
              <TextBox Style="{StaticResource FieldInput}" Text="{Binding FechaProgramada, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Fecha programada, dd/mm/aaaa" />
            </Border>
            <TextBlock Text="dd/mm/aaaa" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorFecha}" Style="{StaticResource FieldError}" AutomationProperties.LiveSetting="Assertive"
                       Visibility="{Binding ErrorFecha, Converter={StaticResource TextoVisible}}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
