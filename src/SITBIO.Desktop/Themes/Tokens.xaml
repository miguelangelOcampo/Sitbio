<!-- Tokens independientes del tema: tipografía, espaciado y radios (DOC-05). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
  <sys:Double x:Key="Font.Size.Body">14</sys:Double>
  <sys:Double x:Key="Font.Size.Title">20</sys:Double>
  <sys:Double x:Key="Size.Control">42</sys:Double>
  <Thickness x:Key="Space.2">8</Thickness>
  <Thickness x:Key="Space.4">16</Thickness>
  <Thickness x:Key="Space.6">24</Thickness>
  <CornerRadius x:Key="Radius.Card">16</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
  <CornerRadius x:Key="Radius.Button">9</CornerRadius>
  <CornerRadius x:Key="Radius.Field">8</CornerRadius>
</ResourceDictionary>
