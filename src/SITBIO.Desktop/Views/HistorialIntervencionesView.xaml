<!-- Historial de intervenciones (HU-005; opción HIST; prototipo: HistorialIntervenciones). Indicadores del filtro
     en franja, filtros y tabla abierta de la más reciente a la más antigua. Cada fila abre la intervención en
     solo lectura (UI-013), que reemplaza la lista mientras está abierta, o la hoja de vida del equipo (UI-006).
     El tipo de mantenimiento va con punto y texto, no solo color (ACC-001). -->
<UserControl x:Class="Sitbio.Desktop.Views.HistorialIntervencionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sitbio.Desktop.ViewModels"
             xmlns:views="clr-namespace:Sitbio.Desktop.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <views:TextoVisibleConverter x:Key="TextoVisible" />
    <views:NuloVisibleConverter x:Key="NuloVisible" />
    <views:RecursoConverter x:Key="Recurso" />

    <DataTemplate DataType="{x:Type vm:IntervencionViewModel}">
      <views:IntervencionView />
    </DataTemplate>

    <!-- Campo de fecha: caja con texto de ayuda mientras está vacía; roja si hay error de fechas -->
    <Style x:Key="CampoFecha" TargetType="Border" BasedOn="{StaticResource FieldBox}">
      <Setter Property="MinHeight" Value="42" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ErrorFechas, Converter={StaticResource TextoVisible}}" Value="Visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Ayuda" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="15,0,0,0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Tipo: correctivo en ámbar, preventivo en azul -->
    <Style x:Key="PuntoTipo" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
      <Setter Property="Fill" Value="{DynamicResource Brush.Info}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding EsCorrectivo}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- UI-013 Intervención en solo lectura -->
    <ContentControl Content="{Binding Intervencion}" Focusable="False" IsTabStop="False"
                    Visibility="{Binding Intervencion, Converter={StaticResource NuloVisible}}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  Visibility="{Binding EnLista, Converter={StaticResource Visible}}">
      <StackPanel Margin="40,32,40,40" MaxWidth="1160" HorizontalAlignment="Stretch">
        <!-- Encabezado -->
        <TextBlock Text="GESTIÓN BIOMÉDICA" Style="{StaticResource Overline}" />
        <TextBlock Text="Historial de intervenciones" Style="{StaticResource PageTitle}" Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,24" TextWrapping="Wrap"
                   Text="Intervenciones registradas por los técnicos en los equipos de tu institución, de la más reciente a la más antigua." />

        <!-- Aviso de error -->
        <Border Style="{StaticResource InfoBar}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive"
                Visibility="{Binding Aviso, Converter={StaticResource NuloVisible}}" ToolTip="{Binding Aviso.Codigo}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Alerta}"
                            Foreground="{DynamicResource Brush.DangerText}" VerticalAlignment="Top" Margin="0,1,10,0" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Aviso.Titulo}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Aviso.Mensaje}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
              <Button views:Boton.Icono="{StaticResource Icono.Reintentar}" Content="Reintentar" Style="{StaticResource LinkButton}" Command="{Binding BuscarCommand}" Margin="0,0,16,0"
                      Visibility="{Binding Aviso.PuedeReintentar, Converter={StaticResource Visible}}" />
              <Button Content="Cerrar" Style="{StaticResource LinkButton}" Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Indicadores de todo el filtro -->
        <Border Style="{StaticResource KpiStrip}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource KpiItem}" BorderThickness="0" Padding="0,14,20,14">
              <StackPanel>
                <TextBlock Text="INTERVENCIONES" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding Intervenciones}" Style="{StaticResource KpiValue}" />
                <TextBlock Text="Con los filtros actuales" Style="{StaticResource Muted}" FontSize="13" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KpiItem}">
              <StackPanel>
                <TextBlock Text="CORRECTIVAS" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding Correctivas}" Style="{StaticResource KpiValue}" />
                <TextBlock Text="{Binding DetalleCorrectivas}" Style="{StaticResource Muted}" FontSize="13" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiItem}">
              <StackPanel>
                <TextBlock Text="COSTO TOTAL" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding CostoTotal}" Style="{StaticResource KpiValue}" />
                <TextBlock Text="Repuestos y mano de obra" Style="{StaticResource Muted}" FontSize="13" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KpiItem}">
              <StackPanel>
                <TextBlock Text="TIEMPO PROMEDIO" Style="{StaticResource Overline}" />
                <TextBlock Text="{Binding TiempoPromedio}" Style="{StaticResource KpiValue}" />
                <TextBlock Text="De atención por intervención" Style="{StaticResource Muted}" FontSize="13" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Filtros -->
        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource FieldBox}" MinHeight="42">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icono}" Content="{StaticResource Icono.Buscar}" Width="16" Height="16"
                              Foreground="{DynamicResource Brush.Text3}" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding TextoEquipo, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Buscar por código de activo, serie, marca, modelo o tipo de equipo">
                <TextBox.InputBindings>
                  <KeyBinding Key="Return" Command="{Binding BuscarCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>
          </Border>
          <TextBlock Text="Código de activo o modelo" Margin="50,0,0,0" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Ayuda}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TextoEquipo.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ComboBox Grid.Column="2" Style="{StaticResource FieldCombo}" ItemsSource="{Binding OpcionesTipo}"
                    SelectedItem="{Binding FiltroTipo}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por tipo de equipo" />
          <ComboBox Grid.Column="4" Style="{StaticResource FieldCombo}" ItemsSource="{x:Static vm:HistorialIntervencionesViewModel.OpcionesMantenimiento}"
                    SelectedItem="{Binding FiltroMantenimiento}" DisplayMemberPath="Texto" AutomationProperties.Name="Filtrar por tipo de mantenimiento" />

          <Border Grid.Column="6" Style="{StaticResource CampoFecha}">
            <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Desde}" AutomationProperties.Name="Desde (dd/mm/aaaa)" />
          </Border>
          <TextBlock Grid.Column="6" Text="Desde dd/mm/aaaa">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Ayuda}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Desde.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <Border Grid.Column="8" Style="{StaticResource CampoFecha}">
            <TextBox Style="{StaticResource FieldInput}" FontSize="14" Text="{Binding Hasta}" AutomationProperties.Name="Hasta (dd/mm/aaaa)" />
          </Border>
          <TextBlock Grid.Column="8" Text="Hasta dd/mm/aaaa">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Ayuda}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Hasta.Length}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button views:Boton.Icono="{StaticResource Icono.Buscar}" Content="Buscar" Style="{StaticResource LinkButton}" Command="{Binding BuscarCommand}" />
            <Button Content="Limpiar" Style="{StaticResource LinkButton}" Command="{Binding LimpiarCommand}" Margin="16,0,0,0"
                    Visibility="{Binding HayFiltros, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding ErrorFechas}" Style="{StaticResource FieldError}"
                   Visibility="{Binding ErrorFechas, Converter={StaticResource TextoVisible}}" />

        <!-- Tabla abierta -->
        <DataGrid Style="{StaticResource OpenGrid}" ItemsSource="{Binding Filas}" RowHeight="64" Margin="0,8,0,0"
                  AutomationProperties.Name="Intervenciones registradas" ScrollViewer.CanContentScroll="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="FECHA" Width="0.85*" MinWidth="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Fecha}" />
                    <TextBlock Text="{Binding Hora}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="EQUIPO" Width="1.5*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.PrimarySoft}">
                      <ContentControl Style="{StaticResource Icono}" Content="{Binding IconoTipo, Converter={StaticResource Recurso}}" Width="16" Height="16"
                                      Foreground="{DynamicResource Brush.Primary}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Intervencion.PlacaInventario}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Equipo}" />
                      <TextBlock Text="{Binding Intervencion.TipoEquipo}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="TIPO" Width="1*" MinWidth="112">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource PuntoTipo}" />
                      <TextBlock Text="{Binding Tipo}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Referencia}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Brush.Text2}" Margin="16,0,0,0" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="TÉCNICO" Width="1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tecnico}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tecnico}" />
                    <TextBlock Text="{Binding Tiempo}" FontSize="12" Foreground="{DynamicResource Brush.Text2}"
                               Visibility="{Binding Tiempo, Converter={StaticResource TextoVisible}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="DIAGNÓSTICO" Width="1.6*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <TextBlock Text="{Binding Diagnostico}" Foreground="{DynamicResource Brush.Text2}" TextWrapping="Wrap" MaxHeight="38"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding Diagnostico}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="SALIDA" Width="1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Salida}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Firma}" FontSize="12" Foreground="{DynamicResource Brush.Text2}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="COSTO" Width="0.8*" MinWidth="84">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <TextBlock Text="{Binding Costo}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="" Width="Auto" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FilaHistorial}">
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button views:Boton.Icono="{StaticResource Icono.Ojo}" Content="Ver intervención" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            Visibility="{Binding DataContext.PuedeVerIntervencion, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"
                            Command="{Binding DataContext.AbrirIntervencionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Equipo, StringFormat='Ver la intervención de {0}'}" />
                    <Button views:Boton.Icono="{StaticResource Icono.Documento}" Content="Hoja de vida" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,4,0,0"
                            Command="{Binding DataContext.AbrirHojaVidaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Equipo, StringFormat='Hoja de vida de {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Consultando el historial…" Style="{StaticResource Muted}" Margin="0,16,0,0"
                   Visibility="{Binding Cargando, Converter={StaticResource Visible}}" />
        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{Binding SinIntervenciones, Converter={StaticResource Visible}}">
          <ContentControl Style="{StaticResource Icono}" Content="{StaticResource Icono.Historial}" Width="28" Height="28"
                          Foreground="{DynamicResource Brush.Text3}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Text="Sin intervenciones con esos criterios" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
          <TextBlock TextAlignment="Center" HorizontalAlignment="Center" Text="Cambia el equipo, el tipo o las fechas, o usa «Limpiar» para ver todo." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Pie: resumen y paginación -->
        <DockPanel Margin="0,14,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="‹ Anterior" Style="{StaticResource LinkButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,20,0"
                    AutomationProperties.Name="Página anterior" />
            <Button Content="Siguiente ›" Style="{StaticResource LinkButton}" Command="{Binding PaginaSiguienteCommand}"
                    AutomationProperties.Name="Página siguiente" />
          </StackPanel>
          <TextBlock Text="{Binding ResumenPagina}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
